+			store := newFakeStore()
+			store.createE = &StatusError{Op: "create", Status: errSecMissingEntitlement}
+			spec := validSpec("se")
+			spec.Store, spec.UserPresence = tc.store, tc.userPresence
+			_, err := newTestManager(t, store).Init(spec)
