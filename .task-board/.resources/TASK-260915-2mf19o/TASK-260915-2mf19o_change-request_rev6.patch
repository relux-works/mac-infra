+func refusalCode(t *testing.T, err error) string {
+	t.Helper()
+	var refusal *Refusal
+	if !errors.As(err, &refusal) {
+		t.Fatalf("expected a Refusal, got %v", err)
+	}
+	if refusal.Hint == "" {
+		t.Fatalf("refusal %s carries no hint: %v", refusal.Code, err)
+	}
+	return refusal.Code
+}
