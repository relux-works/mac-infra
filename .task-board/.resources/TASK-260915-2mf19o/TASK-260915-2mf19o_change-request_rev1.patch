+// guardedBackend fails any Create/Delete outside the test prefix before it
+// reaches the real keychain and remembers labels for cleanup.
+type guardedBackend struct {
+	t       *testing.T
+	inner   keyvault.Backend
+	touched []string
+}
+
+func (g *guardedBackend) guard(label string) error {
+	if !strings.HasPrefix(label, testPrefix) {
+		g.t.Errorf("test guard: %q is outside %s", label, testPrefix)
+		return fmt.Errorf("test guard refused %q", label)
+	}
+	g.touched = append(g.touched, label)
+	return nil
+}
+
+func (g *guardedBackend) Create(opts keyvault.CreateOptions) (keyvault.Key, error) {
+	if err := g.guard(opts.Label); err != nil {
+		return keyvault.Key{}, err
+	}
+	return g.inner.Create(opts)
+}
+
+func (g *guardedBackend) List() ([]keyvault.Key, error) { return g.inner.List() }
+
+func (g *guardedBackend) Delete(label string) error {
+	if err := g.guard(label); err != nil {
+		return err
+	}
+	return g.inner.Delete(label)
+}
+
+// End-to-end against the login keychain on this Mac through the production
+// SecurityStore: init, list, pub, rotate, delete, the explicit --enclave
+// refusal with -34018, and the duplicate refusal. All labels are test
+// prefixed and removed in cleanup.
+func TestRunAgainstLoginKeychain(t *testing.T) {
+	if os.Getenv("MAC_KEYVAULT_SKIP_KEYCHAIN") != "" {
+		t.Skip("MAC_KEYVAULT_SKIP_KEYCHAIN set")
+	}
+	guard := &guardedBackend{t: t, inner: keyvault.NewSecurityStore()}
+	useStore(t, guard)
+	t.Cleanup(func() {
+		for _, label := range guard.touched {
+			if err := guard.inner.Delete(label); err != nil && !errors.Is(err, keyvault.ErrNotFound) {
+				t.Errorf("cleanup %s: %v", label, err)
+			}
+		}
+	})
+	short := fmt.Sprintf("test.cli-e2e-%d", os.Getpid())
+	label := keyvault.LabelPrefix + short
+
+	code, resp, raw := runJSON(t, "init", short)
+	if code != exitOK {
+		t.Fatalf("init: %s", raw)
+	}
+	fingerprint := resultMap(t, resp)["fingerprint"].(string)
+
+	if code, resp, raw = runJSON(t, "init", short); code != exitRefused || resp.Error.Code != keyvault.CodeDuplicateLabel {
+		t.Fatalf("duplicate: %s", raw)
+	}
+	if code, resp, raw = runJSON(t, "init", short+"-se", "--enclave"); code != exitRefused || resp.Error.Code != keyvault.CodeEnclaveUnavailable || resp.Error.Status != -34018 {
+		t.Fatalf("enclave: %s", raw)
+	}
+	if err := guard.inner.Delete(label + "-se"); !errors.Is(err, keyvault.ErrNotFound) {
+		t.Fatalf("enclave refusal left a keychain key behind: %v", err)
+	}
+
+	_, resp, raw = runJSON(t, "list")
+	found := false
+	for _, item := range resp.Result.([]any) {
+		view := item.(map[string]any)
+		if view["label"] == label {
+			found = view["store"] == "keychain" && view["fingerprint"] == fingerprint && view["created"] != ""
+		}
+	}
+	if !found {
+		t.Fatalf("list lacks the created key with all columns: %s", raw)
+	}
+
+	derPath := filepath.Join(t.TempDir(), "spki.der")
+	if code, _, raw = runJSON(t, "pub", short, "--out", derPath); code != exitOK {
+		t.Fatalf("pub: %s", raw)
+	}
+	der, err := os.ReadFile(derPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := x509.ParsePKIXPublicKey(der); err != nil {
+		t.Fatalf("pub wrote an unparsable SPKI: %v", err)
+	}
+
+	if code, resp, raw = runJSON(t, "rotate", short); code != exitOK {
+		t.Fatalf("rotate: %s", raw)
+	}
+	if resultMap(t, resp)["new"].(map[string]any)["label"] != label+".v2" {
+		t.Fatalf("rotate: %s", raw)
+	}
+	if code, _, raw = runJSON(t, "pub", short); code != exitOK {
+		t.Fatalf("old key gone after rotate: %s", raw)
+	}
+
+	if code, resp, raw = runJSON(t, "delete", short); code != exitRefused || resp.Error.Code != keyvault.CodeConfirmationRequired {
+		t.Fatalf("delete unconfirmed: %s", raw)
+	}
+	for _, l := range []string{short, short + ".v2"} {
+		if code, _, raw = runJSON(t, "delete", l, "--confirm"); code != exitOK {
+			t.Fatalf("delete %s: %s", l, raw)
+		}
+	}
+	if code, resp, raw = runJSON(t, "delete", short, "--confirm"); code != exitFailure || resp.Error.Code != "not_found" {
+		t.Fatalf("delete twice: %s", raw)
+	}
+	for _, touched := range guard.touched {
+		if !strings.HasPrefix(touched, testPrefix) {
+			t.Fatalf("non-test label touched: %s", touched)
+		}
+	}
+}
diff --git a/internal/keyvault/keyvault.go b/internal/keyvault/keyvault.go
new file mode 100644
index 0000000..3e7cede
--- /dev/null
+++ b/internal/keyvault/keyvault.go
@@ -0,0 +1,323 @@
+// Package keyvault manages non-extractable P-256 key pairs in the login
+// keychain for mac-keyvault. Policy gates (label prefix, duplicate labels,
+// delete confirmation, explicit Secure Enclave refusal) live in Manager so
+// they run before any Security.framework call.
+package keyvault
+
+import (
+	"crypto/ecdh"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// LabelPrefix is the only namespace mac-keyvault creates, lists, or deletes.
+const LabelPrefix = "works.relux.mac-keyvault."
+
+// TestLabelPrefix is the namespace the test suites are allowed to touch.
+const TestLabelPrefix = LabelPrefix + "test."
+
+// errSecMissingEntitlement is Security.framework's answer when the calling
+// binary lacks the provisioning profile the Data Protection keychain and the
+// Secure Enclave require.
+const errSecMissingEntitlement = -34018
+
+const errSecItemNotFound = -25300
+
+// StoreKind names where a key pair lives.
+type StoreKind string
+
+const (
+	StoreKeychain StoreKind = "keychain"
+	StoreEnclave  StoreKind = "enclave"
+	StoreUnknown  StoreKind = "unknown"
+)
+
+// Key is one managed key pair. SPKI is the DER SubjectPublicKeyInfo; it is
+// empty when the public half could not be read.
+type Key struct {
+	Label   string
+	Store   StoreKind
+	Created time.Time
+	SPKI    []byte
+}
+
+// Fingerprint is base64url(SHA-256(DER(SPKI))) without padding, or "" when
+// the SPKI is unknown.
+func (k Key) Fingerprint() string {
+	if len(k.SPKI) == 0 {
+		return ""
+	}
+	sum := sha256.Sum256(k.SPKI)
+	return base64.RawURLEncoding.EncodeToString(sum[:])
+}
+
+// CreateOptions describes a key pair to generate.
+type CreateOptions struct {
+	Label        string
+	Store        StoreKind
+	UserPresence bool
+	Created      time.Time
+}
+
+// Backend is the key store the Manager gates. The production implementation
+// is SecurityStore.
+type Backend interface {
+	Create(opts CreateOptions) (Key, error)
+	// List returns every key whose label carries LabelPrefix.
+	List() ([]Key, error)
+	// Delete removes the pair under label or returns ErrNotFound.
+	Delete(label string) error
+}
+
+// ErrNotFound reports a label with no key pair behind it.
+var ErrNotFound = errors.New("key not found")
+
+// StatusError carries a raw Security.framework OSStatus.
+type StatusError struct {
+	Op     string
+	Status int
+}
+
+func (e *StatusError) Error() string {
+	return fmt.Sprintf("Security.framework %s failed: OSStatus %d", e.Op, e.Status)
+}
+
+// Refusal is a policy gate rejection raised before or instead of a store call.
+type Refusal struct {
+	Code    string
+	Message string
+	Status  int // underlying OSStatus when a Security call produced the refusal
+}
+
+func (e *Refusal) Error() string {
+	if e.Status != 0 {
+		return fmt.Sprintf("%s: %s (OSStatus %d)", e.Code, e.Message, e.Status)
+	}
+	return fmt.Sprintf("%s: %s", e.Code, e.Message)
+}
+
+// Refusal codes.
+const (
+	CodeInvalidLabel         = "invalid_label"
+	CodeForeignLabel         = "foreign_label"
+	CodeDuplicateLabel       = "duplicate_label"
+	CodeConfirmationRequired = "confirmation_required"
+	CodeEnclaveUnavailable   = "enclave_unavailable"
+	CodeUserPresenceUnavail  = "user_presence_unavailable"
+	CodeUnsupportedStore     = "unsupported_store"
+)
+
+var labelPattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]*$`)
+
+// ResolveLabel maps CLI input to a full label: input already carrying
+// LabelPrefix is used as is, anything else is placed under the prefix. The
+// result is always inside the tool's namespace.
+func ResolveLabel(input string) (string, error) {
+	input = strings.TrimSpace(input)
+	name := strings.TrimPrefix(input, LabelPrefix)
+	if name == "" || !labelPattern.MatchString(name) || strings.Contains(name, "..") {
+		return "", &Refusal{Code: CodeInvalidLabel, Message: fmt.Sprintf("label %q must match %s and must not contain \"..\"", input, labelPattern)}
+	}
+	return LabelPrefix + name, nil
+}
+
+// RequireOwnLabel refuses any label outside LabelPrefix. It is the guard every
+// mutating Manager path runs before touching the store.
+func RequireOwnLabel(label string) error {
+	if !strings.HasPrefix(label, LabelPrefix) || len(label) == len(LabelPrefix) {
+		return &Refusal{Code: CodeForeignLabel, Message: fmt.Sprintf("label %q is outside the %s namespace; refusing to touch it", label, LabelPrefix)}
+	}
+	return nil
+}
+
+// Manager applies the policy gates around a Backend.
+type Manager struct {
+	backend Backend
+	now     func() time.Time
+}
+
+// NewManager wires the gates around backend.
+func NewManager(backend Backend) *Manager {
+	return &Manager{backend: backend, now: time.Now}
+}
+
+// SetClock overrides the creation timestamp source.
+func (m *Manager) SetClock(now func() time.Time) {
+	m.now = now
+}
+
+func (m *Manager) lookup(label string) (Key, bool, error) {
+	keys, err := m.backend.List()
+	if err != nil {
+		return Key{}, false, err
+	}
+	for _, key := range keys {
+		if key.Label == label {
+			return key, true, nil
+		}
+	}
+	return Key{}, false, nil
+}
+
+// Init creates a new pair under label. A duplicate label is refused before
+// the store is asked to create anything; a Secure Enclave or user-presence
+// request that Security.framework rejects with -34018 is refused with the
+// documented reason instead of falling back to the plain keychain.
+func (m *Manager) Init(label string, store StoreKind, userPresence bool) (Key, error) {
+	if err := RequireOwnLabel(label); err != nil {
+		return Key{}, err
+	}
+	switch store {
+	case StoreKeychain, StoreEnclave:
+	default:
+		return Key{}, &Refusal{Code: CodeUnsupportedStore, Message: fmt.Sprintf("store %q is not supported; use keychain or enclave", store)}
+	}
+	if _, exists, err := m.lookup(label); err != nil {
+		return Key{}, err
+	} else if exists {
+		return Key{}, &Refusal{Code: CodeDuplicateLabel, Message: fmt.Sprintf("label %q already exists; rotate it or delete it first", label)}
+	}
+	key, err := m.backend.Create(CreateOptions{Label: label, Store: store, UserPresence: userPresence, Created: m.now().UTC().Truncate(time.Second)})
+	if err != nil {
+		var status *StatusError
+		if errors.As(err, &status) && status.Status == errSecMissingEntitlement {
+			if store == StoreEnclave {
+				return Key{}, &Refusal{Code: CodeEnclaveUnavailable, Status: status.Status, Message: "Secure Enclave refused the permanent key: the binary is not signed with a provisioning profile (errSecMissingEntitlement); no keychain fallback was made, rerun without --enclave to use the login keychain"}
+			}
+			return Key{}, &Refusal{Code: CodeUserPresenceUnavail, Status: status.Status, Message: "user-presence ACL needs the Data Protection keychain, which refused this unprovisioned binary (errSecMissingEntitlement); no key was created, rerun without --user-presence"}
+		}
+		return Key{}, err
+	}
+	return key, nil
+}
+
+// List returns the managed keys sorted by label.
+func (m *Manager) List() ([]Key, error) {
+	keys, err := m.backend.List()
+	if err != nil {
+		return nil, err
+	}
+	filtered := keys[:0:0]
+	for _, key := range keys {
+		if RequireOwnLabel(key.Label) == nil {
+			filtered = append(filtered, key)
+		}
+	}
+	sort.Slice(filtered, func(i, j int) bool { return filtered[i].Label < filtered[j].Label })
+	return filtered, nil
+}
+
+// Public returns the key behind label or ErrNotFound.
+func (m *Manager) Public(label string) (Key, error) {
+	if err := RequireOwnLabel(label); err != nil {
+		return Key{}, err
+	}
+	key, ok, err := m.lookup(label)
+	if err != nil {
+		return Key{}, err
+	}
+	if !ok {
+		return Key{}, fmt.Errorf("%w: %s", ErrNotFound, label)
+	}
+	return key, nil
+}
+
+// RotateResult reports the retained old pair and the new versioned pair.
+type RotateResult struct {
+	Old Key
+	New Key
+}
+
+var versionSuffix = regexp.MustCompile(`\.v([0-9]+)$`)
+
+// BaseLabel strips a .v<N> rotation suffix.
+func BaseLabel(label string) string {
+	return versionSuffix.ReplaceAllString(label, "")
+}
+
+// Rotate creates <base>.v<N+1> in the same store as the newest existing
+// version and keeps every older version until it is deleted explicitly.
+func (m *Manager) Rotate(label string) (RotateResult, error) {
+	if err := RequireOwnLabel(label); err != nil {
+		return RotateResult{}, err
+	}
+	keys, err := m.List()
+	if err != nil {
+		return RotateResult{}, err
+	}
+	base := BaseLabel(label)
+	newest, version := Key{}, 0
+	found := false
+	for _, key := range keys {
+		if key.Label == base {
+			if !found {
+				newest = key
+				found = true
+			}
+			continue
+		}
+		match := versionSuffix.FindStringSubmatch(strings.TrimPrefix(key.Label, base))
+		if match == nil || !strings.HasPrefix(key.Label, base+".v") {
+			continue
+		}
+		n, _ := strconv.Atoi(match[1])
+		if n > version {
+			version, newest, found = n, key, true
+		}
+	}
+	if !found {
+		return RotateResult{}, fmt.Errorf("%w: %s", ErrNotFound, base)
+	}
+	store := newest.Store
+	if store == StoreUnknown {
+		store = StoreKeychain
+	}
+	next := fmt.Sprintf("%s.v%d", base, max(version, 1)+1)
+	created, err := m.Init(next, store, false)
+	if err != nil {
+		return RotateResult{}, err
+	}
+	return RotateResult{Old: newest, New: created}, nil
+}
+
+// Delete removes the pair under label. It refuses without confirmation and
+// refuses any label outside LabelPrefix; both refusals happen before the
+// backend is called.
+func (m *Manager) Delete(label string, confirmed bool) error {
+	if err := RequireOwnLabel(label); err != nil {
+		return err
+	}
+	if !confirmed {
+		return &Refusal{Code: CodeConfirmationRequired, Message: fmt.Sprintf("deleting %q is irreversible; pass --confirm", label)}
+	}
+	if err := m.backend.Delete(label); err != nil {
+		if errors.Is(err, ErrNotFound) {
+			return fmt.Errorf("%w: %s", ErrNotFound, label)
+		}
+		return err
+	}
+	return nil
+}
+
+// spkiFromPoint converts an uncompressed X9.63 P-256 point into DER SPKI.
+func spkiFromPoint(point []byte) ([]byte, error) {
+	pub, err := ecdh.P256().NewPublicKey(point)
+	if err != nil {
+		return nil, fmt.Errorf("public key point: %w", err)
+	}
+	return x509.MarshalPKIXPublicKey(pub)
+}
+
+// EncodePEM wraps DER SPKI as a PUBLIC KEY PEM block.
+func EncodePEM(spki []byte) []byte {
+	return pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: spki})
+}
diff --git a/internal/keyvault/keyvault_test.go b/internal/keyvault/keyvault_test.go
new file mode 100644
index 0000000..ca9c136
--- /dev/null
+++ b/internal/keyvault/keyvault_test.go
@@ -0,0 +1,388 @@
+package keyvault
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+// fakeStore records every call so tests can prove which labels reached the
+// store and which refusals happened before any store call.
+type fakeStore struct {
+	keys    map[string]Key
+	creates []CreateOptions
+	deletes []string
+	lists   int
+	createE error
+}
+
+func newFakeStore(labels ...string) *fakeStore {
+	s := &fakeStore{keys: map[string]Key{}}
+	for _, label := range labels {
+		s.keys[label] = Key{Label: label, Store: StoreKeychain, Created: time.Unix(1_700_000_000, 0).UTC(), SPKI: []byte{0x30, 0x59}}
+	}
+	return s
+}
+
+func (s *fakeStore) Create(opts CreateOptions) (Key, error) {
+	s.creates = append(s.creates, opts)
+	if s.createE != nil {
+		return Key{}, s.createE
+	}
+	key := Key{Label: opts.Label, Store: opts.Store, Created: opts.Created, SPKI: []byte{0x30, 0x59, byte(len(s.creates))}}
+	s.keys[opts.Label] = key
+	return key, nil
+}
+
+func (s *fakeStore) List() ([]Key, error) {
+	s.lists++
+	var out []Key
+	for _, key := range s.keys {
+		out = append(out, key)
+	}
+	return out, nil
+}
+
+func (s *fakeStore) Delete(label string) error {
+	s.deletes = append(s.deletes, label)
+	if _, ok := s.keys[label]; !ok {
+		return ErrNotFound
+	}
+	delete(s.keys, label)
+	return nil
+}
+
+func refusalCode(t *testing.T, err error) string {
+	t.Helper()
+	var refusal *Refusal
+	if !errors.As(err, &refusal) {
+		t.Fatalf("expected a Refusal, got %v", err)
+	}
+	return refusal.Code
+}
+
+// ResolveLabel always lands inside LabelPrefix and refuses shapes that could
+// escape it or address another owner's item.
+func TestResolveLabel(t *testing.T) {
+	for name, tc := range map[string]struct {
+		input string
+		want  string
+		code  string
+	}{
+		"short name":              {input: "signer", want: LabelPrefix + "signer"},
+		"already prefixed":        {input: LabelPrefix + "signer", want: LabelPrefix + "signer"},
+		"dots and versions":       {input: "test.signer.v2", want: LabelPrefix + "test.signer.v2"},
+		"foreign reverse dns":     {input: "com.apple.security", want: LabelPrefix + "com.apple.security"},
+		"empty":                   {input: "", code: CodeInvalidLabel},
+		"bare prefix":             {input: LabelPrefix, code: CodeInvalidLabel},
+		"whitespace":              {input: "sig ner", code: CodeInvalidLabel},
+		"path traversal":          {input: "a/../b", code: CodeInvalidLabel},
+		"double dot":              {input: "a..b", code: CodeInvalidLabel},
+		"leading dot":             {input: ".hidden", code: CodeInvalidLabel},
+		"control byte":            {input: "a\x1fb", code: CodeInvalidLabel},
+		"prefix-lookalike prefix": {input: "works.relux.mac-keyvaultX.signer", want: LabelPrefix + "works.relux.mac-keyvaultX.signer"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			got, err := ResolveLabel(tc.input)
+			if tc.code != "" {
+				if refusalCode(t, err) != tc.code {
+					t.Fatalf("code = %v, want %s", err, tc.code)
+				}
+				return
+			}
+			if err != nil || got != tc.want {
+				t.Fatalf("ResolveLabel(%q) = %q, %v; want %q", tc.input, got, err, tc.want)
+			}
+		})
+	}
+}
+
+// RequireOwnLabel admits only labels strictly inside LabelPrefix; the bare
+// prefix, lookalike prefixes, and other namespaces are refused.
+func TestRequireOwnLabel(t *testing.T) {
+	for _, label := range []string{LabelPrefix + "a", TestLabelPrefix + "x.v2"} {
+		if err := RequireOwnLabel(label); err != nil {
+			t.Fatalf("own label %q refused: %v", label, err)
+		}
+	}
+	for _, label := range []string{"", LabelPrefix, "works.relux.other.a", "works.relux.mac-keyvaultX.a", "com.apple.security.key", " " + LabelPrefix + "a"} {
+		if refusalCode(t, RequireOwnLabel(label)) != CodeForeignLabel {
+			t.Fatalf("foreign label %q was admitted", label)
+		}
+	}
+}
+
+// Init refuses a duplicate label before asking the store to create anything;
+// a fresh label reaches the store with the permanent, non-extractable shape.
+func TestManagerInitDuplicateRefusedBeforeCreate(t *testing.T) {
+	existing := TestLabelPrefix + "dup"
+	store := newFakeStore(existing)
+	manager := NewManager(store)
+	manager.SetClock(func() time.Time { return time.Date(2026, 9, 15, 10, 0, 0, 0, time.UTC) })
+
+	if code := refusalCode(t, mustErr(manager.Init(existing, StoreKeychain, false))); code != CodeDuplicateLabel {
+		t.Fatalf("code = %s, want %s", code, CodeDuplicateLabel)
+	}
+	if len(store.creates) != 0 {
+		t.Fatalf("duplicate label reached the store: %+v", store.creates)
+	}
+
+	key, err := manager.Init(TestLabelPrefix+"fresh", StoreKeychain, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(store.creates) != 1 || store.creates[0].Label != TestLabelPrefix+"fresh" || store.creates[0].Store != StoreKeychain {
+		t.Fatalf("create options = %+v", store.creates)
+	}
+	if !key.Created.Equal(time.Date(2026, 9, 15, 10, 0, 0, 0, time.UTC)) || key.Fingerprint() == "" {
+		t.Fatalf("created key = %+v", key)
+	}
+}
+
+func mustErr(_ Key, err error) error { return err }
+
+// Init refuses labels outside the namespace and unknown stores without a
+// store call.
+func TestManagerInitRefusesForeignLabelAndUnknownStore(t *testing.T) {
+	store := newFakeStore()
+	manager := NewManager(store)
+	if code := refusalCode(t, mustErr(manager.Init("com.apple.foo", StoreKeychain, false))); code != CodeForeignLabel {
+		t.Fatalf("code = %s", code)
+	}
+	if code := refusalCode(t, mustErr(manager.Init(TestLabelPrefix+"x", StoreKind("tpm"), false))); code != CodeUnsupportedStore {
+		t.Fatalf("code = %s", code)
+	}
+	if len(store.creates) != 0 || store.lists != 0 {
+		t.Fatalf("store was called: creates=%d lists=%d", len(store.creates), store.lists)
+	}
+}
+
+// A -34018 from the store on an --enclave or --user-presence request becomes
+// an explicit refusal carrying the OSStatus; exactly one create attempt is
+// made and no keychain fallback create follows.
+func TestManagerInitMissingEntitlementIsExplicitRefusal(t *testing.T) {
+	for name, tc := range map[string]struct {
+		store        StoreKind
+		userPresence bool
+		code         string
+	}{
+		"enclave":       {store: StoreEnclave, code: CodeEnclaveUnavailable},
+		"user-presence": {store: StoreKeychain, userPresence: true, code: CodeUserPresenceUnavail},
+	} {
+		t.Run(name, func(t *testing.T) {
+			store := newFakeStore()
+			store.createE = &StatusError{Op: "create", Status: errSecMissingEntitlement}
+			_, err := NewManager(store).Init(TestLabelPrefix+"se", tc.store, tc.userPresence)
+			var refusal *Refusal
+			if !errors.As(err, &refusal) || refusal.Code != tc.code || refusal.Status != errSecMissingEntitlement {
+				t.Fatalf("err = %v, want %s with -34018", err, tc.code)
+			}
+			if !strings.Contains(refusal.Message, "provisioned binary") && !strings.Contains(refusal.Message, "provisioning profile") {
+				t.Fatalf("refusal lacks the documented reason: %s", refusal.Message)
+			}
+			if len(store.creates) != 1 || store.creates[0].Store != tc.store || store.creates[0].UserPresence != tc.userPresence {
+				t.Fatalf("store creates = %+v; want exactly the requested shape and no fallback", store.creates)
+			}
+			if len(store.keys) != 0 {
+				t.Fatalf("a key was created despite the refusal: %v", store.keys)
+			}
+		})
+	}
+}
+
+// Other Security errors pass through as StatusError, not as a refusal.
+func TestManagerInitOtherStatusErrorPassesThrough(t *testing.T) {
+	store := newFakeStore()
+	store.createE = &StatusError{Op: "create", Status: -25293}
+	_, err := NewManager(store).Init(TestLabelPrefix+"x", StoreKeychain, false)
+	var status *StatusError
+	if !errors.As(err, &status) || status.Status != -25293 {
+		t.Fatalf("err = %v", err)
+	}
+	var refusal *Refusal
+	if errors.As(err, &refusal) {
+		t.Fatalf("plain status error was reported as a refusal: %v", err)
+	}
+}
+
+// Delete refuses without confirmation and refuses foreign labels; neither
+// refusal reaches the store. A confirmed own label is deleted; a confirmed
+// missing label reports ErrNotFound.
+func TestManagerDeleteGates(t *testing.T) {
+	own := TestLabelPrefix + "victim"
+	for name, tc := range map[string]struct {
+		label     string
+		confirmed bool
+		code      string
+		notFound  bool
+		reaches   bool
+	}{
+		"own unconfirmed":         {label: own, code: CodeConfirmationRequired},
+		"foreign confirmed":       {label: "com.apple.security.key", confirmed: true, code: CodeForeignLabel},
+		"foreign unconfirmed":     {label: "com.apple.security.key", code: CodeForeignLabel},
+		"sibling namespace":       {label: "works.relux.other.key", confirmed: true, code: CodeForeignLabel},
+		"bare prefix confirmed":   {label: LabelPrefix, confirmed: true, code: CodeForeignLabel},
+		"prefix-only lookalike":   {label: "works.relux.mac-keyvaultX.key", confirmed: true, code: CodeForeignLabel},
+		"own confirmed":           {label: own, confirmed: true, reaches: true},
+		"own missing confirmed":   {label: TestLabelPrefix + "missing", confirmed: true, reaches: true, notFound: true},
+		"empty label confirmed":   {label: "", confirmed: true, code: CodeForeignLabel},
+		"own with leading spaces": {label: "  " + own, confirmed: true, code: CodeForeignLabel},
+	} {
+		t.Run(name, func(t *testing.T) {
+			store := newFakeStore(own)
+			err := NewManager(store).Delete(tc.label, tc.confirmed)
+			if tc.code != "" {
+				if refusalCode(t, err) != tc.code {
+					t.Fatalf("code = %v, want %s", err, tc.code)
+				}
+			} else if tc.notFound {
+				if !errors.Is(err, ErrNotFound) {
+					t.Fatalf("err = %v, want ErrNotFound", err)
+				}
+			} else if err != nil {
+				t.Fatal(err)
+			}
+			if tc.reaches != (len(store.deletes) == 1) {
+				t.Fatalf("store deletes = %v, reaches = %v", store.deletes, tc.reaches)
+			}
+			if _, stillThere := store.keys[own]; stillThere == (tc.reaches && !tc.notFound) {
+				t.Fatalf("own key present = %v after %s", stillThere, name)
+			}
+		})
+	}
+}
+
+// Rotate creates <base>.v<N+1>, keeps every existing version, and derives the
+// version from the newest existing one; a missing base is ErrNotFound and a
+// versioned input rotates its base.
+func TestManagerRotate(t *testing.T) {
+	base := TestLabelPrefix + "rot"
+	for name, tc := range map[string]struct {
+		existing []string
+		input    string
+		wantNew  string
+		wantOld  string
+		notFound bool
+	}{
+		"first rotation":      {existing: []string{base}, input: base, wantNew: base + ".v2", wantOld: base},
+		"second rotation":     {existing: []string{base, base + ".v2"}, input: base, wantNew: base + ".v3", wantOld: base + ".v2"},
+		"gap in versions":     {existing: []string{base, base + ".v5"}, input: base, wantNew: base + ".v6", wantOld: base + ".v5"},
+		"versioned input":     {existing: []string{base, base + ".v2"}, input: base + ".v2", wantNew: base + ".v3", wantOld: base + ".v2"},
+		"base deleted":        {existing: []string{base + ".v2"}, input: base, wantNew: base + ".v3", wantOld: base + ".v2"},
+		"unrelated sibling":   {existing: []string{base, base + "x.v9"}, input: base, wantNew: base + ".v2", wantOld: base},
+		"missing":             {existing: nil, input: base, notFound: true},
+		"only sibling exists": {existing: []string{base + "x"}, input: base, notFound: true},
+	} {
+		t.Run(name, func(t *testing.T) {
+			store := newFakeStore(tc.existing...)
+			result, err := NewManager(store).Rotate(tc.input)
+			if tc.notFound {
+				if !errors.Is(err, ErrNotFound) || len(store.creates) != 0 {
+					t.Fatalf("err = %v, creates = %v", err, store.creates)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if result.New.Label != tc.wantNew || result.Old.Label != tc.wantOld {
+				t.Fatalf("rotate = %s -> %s, want %s -> %s", result.Old.Label, result.New.Label, tc.wantOld, tc.wantNew)
+			}
+			for _, label := range tc.existing {
+				if _, ok := store.keys[label]; !ok {
+					t.Fatalf("rotate removed %s", label)
+				}
+			}
+			if len(store.deletes) != 0 {
+				t.Fatalf("rotate deleted %v", store.deletes)
+			}
+		})
+	}
+	if _, err := NewManager(newFakeStore()).Rotate("com.apple.key"); refusalCode(t, err) != CodeForeignLabel {
+		t.Fatal("foreign rotate admitted")
+	}
+}
+
+// List drops anything outside the namespace even if the store returns it and
+// sorts by label; Public finds exact labels only.
+func TestManagerListFiltersAndPublicLooksUpExact(t *testing.T) {
+	store := newFakeStore(TestLabelPrefix+"b", TestLabelPrefix+"a", "com.apple.leak", LabelPrefix)
+	manager := NewManager(store)
+	keys, err := manager.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(keys) != 2 || keys[0].Label != TestLabelPrefix+"a" || keys[1].Label != TestLabelPrefix+"b" {
+		t.Fatalf("list = %+v", keys)
+	}
+	if _, err := manager.Public(TestLabelPrefix + "a"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := manager.Public(TestLabelPrefix + "a."); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("err = %v", err)
+	}
+	if _, err := manager.Public("com.apple.leak"); refusalCode(t, err) != CodeForeignLabel {
+		t.Fatal("foreign public lookup admitted")
+	}
+}
+
+// Fingerprint is base64url(SHA-256(SPKI)) without padding and empty for an
+// unknown SPKI; EncodePEM wraps the DER as PUBLIC KEY.
+func TestFingerprintAndPEM(t *testing.T) {
+	point := append([]byte{0x04}, make([]byte, 64)...)
+	point[32] = 1 // not a valid point, expected to be refused
+	if _, err := spkiFromPoint(point); err == nil {
+		t.Fatal("off-curve point accepted")
+	}
+	// Generator point of P-256.
+	gx := "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"
+	gy := "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"
+	spki, err := spkiFromPoint(mustHex("04" + gx + gy))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(spki) != 91 || spki[0] != 0x30 {
+		t.Fatalf("spki = %x", spki)
+	}
+	key := Key{SPKI: spki}
+	fp := key.Fingerprint()
+	if len(fp) != 43 || strings.ContainsAny(fp, "+/=") {
+		t.Fatalf("fingerprint = %q", fp)
+	}
+	if (Key{}).Fingerprint() != "" {
+		t.Fatal("unknown SPKI produced a fingerprint")
+	}
+	pemText := string(EncodePEM(spki))
+	if !strings.HasPrefix(pemText, "-----BEGIN PUBLIC KEY-----\n") || !strings.HasSuffix(pemText, "-----END PUBLIC KEY-----\n") {
+		t.Fatalf("pem = %q", pemText)
+	}
+}
+
+func mustHex(s string) []byte {
+	out := make([]byte, len(s)/2)
+	for i := range out {
+		var b byte
+		for _, c := range s[2*i : 2*i+2] {
+			b <<= 4
+			switch {
+			case c >= '0' && c <= '9':
+				b |= byte(c - '0')
+			case c >= 'a' && c <= 'f':
+				b |= byte(c-'a') + 10
+			}
+		}
+		out[i] = b
+	}
+	return out
+}
+
+func TestBaseLabel(t *testing.T) {
+	for in, want := range map[string]string{
+		"a.v2": "a", "a.v10": "a", "a": "a", "a.v": "a.v", "a.vx": "a.vx", "a.v2.v3": "a.v2",
+	} {
+		if got := BaseLabel(in); got != want {
+			t.Fatalf("BaseLabel(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
diff --git a/internal/keyvault/security_darwin.c b/internal/keyvault/security_darwin.c
new file mode 100644
index 0000000..c04db55
--- /dev/null
+++ b/internal/keyvault/security_darwin.c
@@ -0,0 +1,243 @@
+// Security.framework bridge for mac-keyvault.
+//
+// Store decision (EPIC-260915-1g0e1c_secure-enclave-probe.md, re-verified in
+// TASK-260915-2mf19o): an ad-hoc signed CLI cannot persist keys in the Secure
+// Enclave or the Data Protection keychain (-34018 errSecMissingEntitlement).
+// kSecAttrAccessControl routes the item to the Data Protection keychain and
+// fails the same way, so the login (file-based) keychain with a legacy
+// SecAccess trusted-application list is the ACL mechanism this bridge uses:
+// the item lives in the current user's login keychain and its private-key
+// operations are trusted only for the calling binary.
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <Security/Security.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "security_darwin.h"
+
+static CFStringRef MacKeyVaultString(const char *value) {
+    return CFStringCreateWithCString(kCFAllocatorDefault, value, kCFStringEncodingUTF8);
+}
+
+static CFDataRef MacKeyVaultData(const char *value) {
+    return CFDataCreate(kCFAllocatorDefault, (const UInt8 *)value, (CFIndex)strlen(value));
+}
+
+static CFMutableDictionaryRef MacKeyVaultDictionary(void) {
+    return CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                     &kCFTypeDictionaryValueCallBacks);
+}
+
+static int MacKeyVaultErrorCode(CFErrorRef error) {
+    if (error == NULL) return MacKeyVaultUnknownError;
+    CFIndex code = CFErrorGetCode(error);
+    return code == 0 ? MacKeyVaultUnknownError : (int)code;
+}
+
+// Copies the uncompressed X9.63 point of the public half into a malloc'd buffer.
+static int MacKeyVaultCopyPublicPoint(SecKeyRef privateKey, unsigned char **out, size_t *outLen) {
+    SecKeyRef publicKey = SecKeyCopyPublicKey(privateKey);
+    if (publicKey == NULL) return MacKeyVaultPublicKeyUnavailable;
+    CFErrorRef error = NULL;
+    CFDataRef point = SecKeyCopyExternalRepresentation(publicKey, &error);
+    CFRelease(publicKey);
+    if (point == NULL) {
+        int code = MacKeyVaultErrorCode(error);
+        if (error != NULL) CFRelease(error);
+        return code;
+    }
+    size_t length = (size_t)CFDataGetLength(point);
+    unsigned char *buffer = malloc(length);
+    if (buffer == NULL) {
+        CFRelease(point);
+        return MacKeyVaultUnknownError;
+    }
+    memcpy(buffer, CFDataGetBytePtr(point), length);
+    CFRelease(point);
+    *out = buffer;
+    *outLen = length;
+    return 0;
+}
+
+// Builds the legacy SecAccess whose trusted-application list contains only the
+// calling binary (SecTrustedApplicationCreateFromPath(NULL) = current process).
+static OSStatus MacKeyVaultCreateAccess(SecAccessRef *out) {
+    SecTrustedApplicationRef self = NULL;
+    OSStatus status = SecTrustedApplicationCreateFromPath(NULL, &self);
+    if (status != errSecSuccess) return status;
+    CFArrayRef trusted = CFArrayCreate(kCFAllocatorDefault, (const void **)&self, 1, &kCFTypeArrayCallBacks);
+    CFRelease(self);
+    status = SecAccessCreate(CFSTR("mac-keyvault private key"), trusted, out);
+    CFRelease(trusted);
+    return status;
+}
+
+int MacKeyVaultCreate(const char *label, const char *tag, int enclave, int userPresence,
+                      unsigned char **outPub, size_t *outPubLen) {
+    CFStringRef labelString = MacKeyVaultString(label);
+    CFDataRef tagData = MacKeyVaultData(tag);
+    CFMutableDictionaryRef privateAttrs = MacKeyVaultDictionary();
+    CFDictionarySetValue(privateAttrs, kSecAttrIsPermanent, kCFBooleanTrue);
+    CFDictionarySetValue(privateAttrs, kSecAttrIsExtractable, kCFBooleanFalse);
+    CFDictionarySetValue(privateAttrs, kSecAttrLabel, labelString);
+    CFDictionarySetValue(privateAttrs, kSecAttrApplicationTag, tagData);
+
+    int result = 0;
+    SecAccessRef access = NULL;
+    SecAccessControlRef control = NULL;
+    if (enclave || userPresence) {
+        // Both shapes need the Data Protection keychain; an unprovisioned binary
+        // gets -34018 here and the caller surfaces that verbatim.
+        SecAccessControlCreateFlags flags = enclave ? kSecAccessControlPrivateKeyUsage : 0;
+        if (userPresence) flags |= kSecAccessControlUserPresence;
+        CFErrorRef error = NULL;
+        control = SecAccessControlCreateWithFlags(kCFAllocatorDefault, kSecAttrAccessibleWhenUnlockedThisDeviceOnly,
+                                                  flags, &error);
+        if (control == NULL) {
+            result = MacKeyVaultErrorCode(error);
+            if (error != NULL) CFRelease(error);
+            goto cleanup;
+        }
+        CFDictionarySetValue(privateAttrs, kSecAttrAccessControl, control);
+    } else {
+        OSStatus status = MacKeyVaultCreateAccess(&access);
+        if (status != errSecSuccess) {
+            result = (int)status;
+            goto cleanup;
+        }
+        CFDictionarySetValue(privateAttrs, kSecAttrAccess, access);
+    }
+
+    CFMutableDictionaryRef attrs = MacKeyVaultDictionary();
+    CFDictionarySetValue(attrs, kSecAttrKeyType, kSecAttrKeyTypeECSECPrimeRandom);
+    int bits = 256;
+    CFNumberRef bitsNumber = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &bits);
+    CFDictionarySetValue(attrs, kSecAttrKeySizeInBits, bitsNumber);
+    CFRelease(bitsNumber);
+    CFDictionarySetValue(attrs, kSecAttrLabel, labelString);
+    CFDictionarySetValue(attrs, kSecPrivateKeyAttrs, privateAttrs);
+    if (enclave) CFDictionarySetValue(attrs, kSecAttrTokenID, kSecAttrTokenIDSecureEnclave);
+
+    CFErrorRef error = NULL;
+    SecKeyRef key = SecKeyCreateRandomKey(attrs, &error);
+    CFRelease(attrs);
+    if (key == NULL) {
+        result = MacKeyVaultErrorCode(error);
+        if (error != NULL) CFRelease(error);
+        goto cleanup;
+    }
+    result = MacKeyVaultCopyPublicPoint(key, outPub, outPubLen);
+    CFRelease(key);
+
+cleanup:
+    if (access != NULL) CFRelease(access);
+    if (control != NULL) CFRelease(control);
+    CFRelease(privateAttrs);
+    CFRelease(tagData);
+    CFRelease(labelString);
+    return result;
+}
+
+static void MacKeyVaultAppendField(CFMutableDataRef out, const void *bytes, CFIndex length, char terminator) {
+    if (bytes != NULL && length > 0) CFDataAppendBytes(out, (const UInt8 *)bytes, length);
+    CFDataAppendBytes(out, (const UInt8 *)&terminator, 1);
+}
+
+static void MacKeyVaultAppendString(CFMutableDataRef out, CFStringRef value, char terminator) {
+    if (value == NULL) {
+        MacKeyVaultAppendField(out, NULL, 0, terminator);
+        return;
+    }
+    CFDataRef data = CFStringCreateExternalRepresentation(kCFAllocatorDefault, value, kCFStringEncodingUTF8, 0);
+    MacKeyVaultAppendField(out, data ? CFDataGetBytePtr(data) : NULL, data ? CFDataGetLength(data) : 0, terminator);
+    if (data != NULL) CFRelease(data);
+}
+
+// Only attributes are read for keys outside `prefix`; SecKeyCopyPublicKey and
+// every other per-key operation run only for labels that carry the prefix.
+int MacKeyVaultList(const char *prefix, char **out, size_t *outLen) {
+    CFMutableDictionaryRef query = MacKeyVaultDictionary();
+    CFDictionarySetValue(query, kSecClass, kSecClassKey);
+    CFDictionarySetValue(query, kSecAttrKeyClass, kSecAttrKeyClassPrivate);
+    CFDictionarySetValue(query, kSecReturnAttributes, kCFBooleanTrue);
+    CFDictionarySetValue(query, kSecReturnRef, kCFBooleanTrue);
+    CFDictionarySetValue(query, kSecMatchLimit, kSecMatchLimitAll);
+    CFTypeRef matches = NULL;
+    OSStatus status = SecItemCopyMatching(query, &matches);
+    CFRelease(query);
+    if (status == errSecItemNotFound) {
+        *out = NULL;
+        *outLen = 0;
+        return 0;
+    }
+    if (status != errSecSuccess) return (int)status;
+    if (matches == NULL || CFGetTypeID(matches) != CFArrayGetTypeID()) {
+        if (matches != NULL) CFRelease(matches);
+        return MacKeyVaultUnknownError;
+    }
+
+    CFMutableDataRef buffer = CFDataCreateMutable(kCFAllocatorDefault, 0);
+    CFIndex count = CFArrayGetCount(matches);
+    size_t prefixLen = strlen(prefix);
+    int result = 0;
+    for (CFIndex i = 0; i < count && result == 0; i++) {
+        CFDictionaryRef item = CFArrayGetValueAtIndex(matches, i);
+        if (CFGetTypeID(item) != CFDictionaryGetTypeID()) continue;
+        CFStringRef label = CFDictionaryGetValue(item, kSecAttrLabel);
+        if (label == NULL || CFGetTypeID(label) != CFStringGetTypeID()) continue;
+        char labelBuffer[1024];
+        if (!CFStringGetCString(label, labelBuffer, sizeof(labelBuffer), kCFStringEncodingUTF8)) continue;
+        if (strncmp(labelBuffer, prefix, prefixLen) != 0) continue;
+
+        CFTypeRef tag = CFDictionaryGetValue(item, kSecAttrApplicationTag);
+        CFTypeRef ref = CFDictionaryGetValue(item, kSecValueRef);
+        if (ref == NULL || CFGetTypeID(ref) != SecKeyGetTypeID()) continue;
+        unsigned char *point = NULL;
+        size_t pointLen = 0;
+        int pointResult = MacKeyVaultCopyPublicPoint((SecKeyRef)ref, &point, &pointLen);
+        MacKeyVaultAppendString(buffer, label, MacKeyVaultFieldSeparator);
+        if (tag != NULL && CFGetTypeID(tag) == CFDataGetTypeID()) {
+            MacKeyVaultAppendField(buffer, CFDataGetBytePtr(tag), CFDataGetLength(tag), MacKeyVaultFieldSeparator);
+        } else {
+            MacKeyVaultAppendField(buffer, NULL, 0, MacKeyVaultFieldSeparator);
+        }
+        char statusText[16];
+        snprintf(statusText, sizeof(statusText), "%d", pointResult);
+        MacKeyVaultAppendField(buffer, statusText, (CFIndex)strlen(statusText), MacKeyVaultFieldSeparator);
+        // Hex keeps the raw point bytes clear of the record framing.
+        static const char hex[] = "0123456789abcdef";
+        for (size_t b = 0; b < pointLen; b++) {
+            char pair[2] = { hex[point[b] >> 4], hex[point[b] & 0x0f] };
+            CFDataAppendBytes(buffer, (const UInt8 *)pair, 2);
+        }
+        MacKeyVaultAppendField(buffer, NULL, 0, MacKeyVaultRecordSeparator);
+        free(point);
+    }
+    CFRelease(matches);
+
+    size_t length = (size_t)CFDataGetLength(buffer);
+    char *copy = malloc(length + 1);
+    if (copy == NULL) {
+        CFRelease(buffer);
+        return MacKeyVaultUnknownError;
+    }
+    memcpy(copy, CFDataGetBytePtr(buffer), length);
+    copy[length] = '\0';
+    CFRelease(buffer);
+    *out = copy;
+    *outLen = length;
+    return result;
+}
+
+int MacKeyVaultDelete(const char *label) {
+    CFStringRef labelString = MacKeyVaultString(label);
+    CFMutableDictionaryRef query = MacKeyVaultDictionary();
+    CFDictionarySetValue(query, kSecClass, kSecClassKey);
+    CFDictionarySetValue(query, kSecAttrLabel, labelString);
+    OSStatus status = SecItemDelete(query);
+    CFRelease(query);
+    CFRelease(labelString);
+    return (int)status;
+}
diff --git a/internal/keyvault/security_darwin.go b/internal/keyvault/security_darwin.go
new file mode 100644
index 0000000..7beec52
--- /dev/null
+++ b/internal/keyvault/security_darwin.go
@@ -0,0 +1,142 @@
+//go:build darwin && cgo
+
+package keyvault
+
+/*
+#cgo LDFLAGS: -framework Security -framework CoreFoundation
+#include <stdlib.h>
+#include "security_darwin.h"
+*/
+import "C"
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+	"unsafe"
+)
+
+// SecurityStore is the production Backend over the login keychain through the
+// Security.framework cgo bridge in security_darwin.c.
+type SecurityStore struct{}
+
+// NewSecurityStore returns the login-keychain backend.
+func NewSecurityStore() *SecurityStore {
+	return &SecurityStore{}
+}
+
+func (s *SecurityStore) Create(opts CreateOptions) (Key, error) {
+	label := C.CString(opts.Label)
+	tag := C.CString(encodeTag(opts))
+	defer C.free(unsafe.Pointer(label))
+	defer C.free(unsafe.Pointer(tag))
+	var point *C.uchar
+	var pointLen C.size_t
+	status := int(C.MacKeyVaultCreate(label, tag, cBool(opts.Store == StoreEnclave), cBool(opts.UserPresence), &point, &pointLen))
+	if status != 0 {
+		return Key{}, &StatusError{Op: "create", Status: status}
+	}
+	defer C.free(unsafe.Pointer(point))
+	spki, err := spkiFromPoint(C.GoBytes(unsafe.Pointer(point), C.int(pointLen)))
+	if err != nil {
+		return Key{}, fmt.Errorf("create %s: %w", opts.Label, err)
+	}
+	return Key{Label: opts.Label, Store: opts.Store, Created: opts.Created, SPKI: spki}, nil
+}
+
+func (s *SecurityStore) List() ([]Key, error) {
+	prefix := C.CString(LabelPrefix)
+	defer C.free(unsafe.Pointer(prefix))
+	var out *C.char
+	var outLen C.size_t
+	status := int(C.MacKeyVaultList(prefix, &out, &outLen))
+	if status != 0 {
+		return nil, &StatusError{Op: "list", Status: status}
+	}
+	if out == nil {
+		return nil, nil
+	}
+	defer C.free(unsafe.Pointer(out))
+	return parseListRecords(C.GoBytes(unsafe.Pointer(out), C.int(outLen)))
+}
+
+func (s *SecurityStore) Delete(label string) error {
+	cLabel := C.CString(label)
+	defer C.free(unsafe.Pointer(cLabel))
+	status := int(C.MacKeyVaultDelete(cLabel))
+	if status == errSecItemNotFound {
+		return ErrNotFound
+	}
+	if status != 0 {
+		return &StatusError{Op: "delete", Status: status}
+	}
+	return nil
+}
+
+func cBool(v bool) C.int {
+	if v {
+		return 1
+	}
+	return 0
+}
+
+// parseListRecords decodes label US tag US pointStatus US point RS records.
+// A key whose public point could not be read is still listed with an empty
+// SPKI so the caller reports the fingerprint as unknown instead of hiding it.
+func parseListRecords(raw []byte) ([]Key, error) {
+	var keys []Key
+	for _, record := range bytes.Split(raw, []byte{C.MacKeyVaultRecordSeparator}) {
+		if len(record) == 0 {
+			continue
+		}
+		fields := bytes.SplitN(record, []byte{C.MacKeyVaultFieldSeparator}, 4)
+		if len(fields) != 4 {
+			return nil, fmt.Errorf("list: malformed bridge record")
+		}
+		key := Key{Label: string(fields[0])}
+		key.Store, key.Created = decodeTag(string(fields[1]))
+		if pointStatus, err := strconv.Atoi(string(fields[2])); err == nil && pointStatus == 0 {
+			point, err := hex.DecodeString(string(fields[3]))
+			if err != nil {
+				return nil, fmt.Errorf("list %s: malformed public key hex", key.Label)
+			}
+			spki, err := spkiFromPoint(point)
+			if err != nil {
+				return nil, fmt.Errorf("list %s: %w", key.Label, err)
+			}
+			key.SPKI = spki
+		}
+		keys = append(keys, key)
+	}
+	return keys, nil
+}
+
+// The legacy keychain key schema has no creation-date attribute, so the
+// application tag carries the tool's own metadata.
+const tagVersion = "mac-keyvault/1"
+
+func encodeTag(opts CreateOptions) string {
+	return fmt.Sprintf("%s store=%s created=%s", tagVersion, opts.Store, opts.Created.UTC().Format(time.RFC3339))
+}
+
+func decodeTag(tag string) (StoreKind, time.Time) {
+	fields := strings.Fields(tag)
+	if len(fields) == 0 || fields[0] != tagVersion {
+		return StoreUnknown, time.Time{}
+	}
+	store, created := StoreUnknown, time.Time{}
+	for _, field := range fields[1:] {
+		switch {
+		case strings.HasPrefix(field, "store="):
+			store = StoreKind(strings.TrimPrefix(field, "store="))
+		case strings.HasPrefix(field, "created="):
+			if parsed, err := time.Parse(time.RFC3339, strings.TrimPrefix(field, "created=")); err == nil {
+				created = parsed
+			}
+		}
+	}
+	return store, created
+}
