diff --git a/cmd/mac-keyvault/main.go b/cmd/mac-keyvault/main.go
new file mode 100644
index 0000000..1885032
--- /dev/null
+++ b/cmd/mac-keyvault/main.go
@@ -0,0 +1,404 @@
+// mac-keyvault manages non-extractable P-256 key pairs in the login keychain.
+//
+// Exit codes: 0 success, 1 operational failure (Security.framework error,
+// unknown label, I/O), 2 usage error, 3 policy refusal (duplicate label,
+// missing --confirm, label outside the tool namespace, Secure Enclave or
+// user-presence unavailable).
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/relux-works/mac-infra/internal/keyvault"
+)
+
+var (
+	Version   = "dev"
+	Commit    = "unknown"
+	BuildDate = "unknown"
+)
+
+const (
+	exitOK      = 0
+	exitFailure = 1
+	exitUsage   = 2
+	exitRefused = 3
+)
+
+// newBackend is the production store; tests swap it for a recording store.
+var newBackend = func() keyvault.Backend { return keyvault.NewSecurityStore() }
+
+func main() {
+	os.Exit(run(os.Args[1:], os.Stdout, os.Stderr))
+}
+
+type keyView struct {
+	Label       string `json:"label"`
+	Store       string `json:"store"`
+	Created     string `json:"created,omitempty"`
+	Fingerprint string `json:"fingerprint,omitempty"`
+}
+
+func viewOf(key keyvault.Key) keyView {
+	view := keyView{Label: key.Label, Store: string(key.Store), Fingerprint: key.Fingerprint()}
+	if !key.Created.IsZero() {
+		view.Created = key.Created.UTC().Format(time.RFC3339)
+	}
+	return view
+}
+
+// response is the JSON envelope every command emits in --json mode.
+type response struct {
+	OK      bool           `json:"ok"`
+	Command string         `json:"command"`
+	Result  any            `json:"result,omitempty"`
+	Error   *responseError `json:"error,omitempty"`
+}
+
+type responseError struct {
+	Code    string `json:"code"`
+	Message string `json:"message"`
+	Status  int    `json:"os_status,omitempty"`
+}
+
+type output struct {
+	command string
+	json    bool
+	stdout  io.Writer
+	stderr  io.Writer
+}
+
+func (o output) success(result any, text func(io.Writer)) int {
+	if o.json {
+		encodeJSON(o.stdout, response{OK: true, Command: o.command, Result: result})
+		return exitOK
+	}
+	text(o.stdout)
+	return exitOK
+}
+
+func (o output) fail(err error) int {
+	code, respErr := classify(err)
+	if o.json {
+		encodeJSON(o.stdout, response{OK: false, Command: o.command, Error: respErr})
+	} else {
+		fmt.Fprintf(o.stderr, "%s failed: %s\n", o.command, respErr.Message)
+	}
+	return code
+}
+
+func classify(err error) (int, *responseError) {
+	var refusal *keyvault.Refusal
+	if errors.As(err, &refusal) {
+		return exitRefused, &responseError{Code: refusal.Code, Message: refusal.Message, Status: refusal.Status}
+	}
+	if errors.Is(err, keyvault.ErrNotFound) {
+		return exitFailure, &responseError{Code: "not_found", Message: err.Error()}
+	}
+	var status *keyvault.StatusError
+	if errors.As(err, &status) {
+		return exitFailure, &responseError{Code: "security_error", Message: err.Error(), Status: status.Status}
+	}
+	return exitFailure, &responseError{Code: "failure", Message: err.Error()}
+}
+
+func encodeJSON(w io.Writer, v any) {
+	enc := json.NewEncoder(w)
+	enc.SetIndent("", "  ")
+	_ = enc.Encode(v)
+}
+
+func run(args []string, stdout, stderr io.Writer) int {
+	jsonMode := false
+	for len(args) > 0 && args[0] == "--json" {
+		jsonMode = true
+		args = args[1:]
+	}
+	if len(args) == 0 {
+		printUsage(stdout)
+		return exitUsage
+	}
+	command, rest := args[0], args[1:]
+	switch command {
+	case "init":
+		return runInit(rest, jsonMode, stdout, stderr)
+	case "list":
+		return runList(rest, jsonMode, stdout, stderr)
+	case "pub":
+		return runPub(rest, jsonMode, stdout, stderr)
+	case "rotate":
+		return runRotate(rest, jsonMode, stdout, stderr)
+	case "delete":
+		return runDelete(rest, jsonMode, stdout, stderr)
+	case "version":
+		fmt.Fprintf(stdout, "mac-keyvault %s %s %s\n", Version, Commit, BuildDate)
+		return exitOK
+	case "help", "--help", "-h":
+		printUsage(stdout)
+		return exitOK
+	default:
+		fmt.Fprintf(stderr, "unknown command %q\n", command)
+		printUsage(stderr)
+		return exitUsage
+	}
+}
+
+func newFlagSet(name string, jsonMode *bool, stderr io.Writer) *flag.FlagSet {
+	fs := flag.NewFlagSet(name, flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.BoolVar(jsonMode, "json", *jsonMode, "emit a JSON envelope on stdout")
+	return fs
+}
+
+// parseInterspersed lets flags follow the positional label
+// (mac-keyvault delete LABEL --confirm), which flag.FlagSet alone does not.
+func parseInterspersed(fs *flag.FlagSet, args []string) ([]string, error) {
+	var positional []string
+	for {
+		if err := fs.Parse(args); err != nil {
+			return nil, err
+		}
+		rest := fs.Args()
+		if len(rest) == 0 {
+			return positional, nil
+		}
+		positional = append(positional, rest[0])
+		args = rest[1:]
+	}
+}
+
+func singleLabel(fs *flag.FlagSet, positional []string, stderr io.Writer) (string, bool) {
+	if len(positional) != 1 {
+		fmt.Fprintf(stderr, "%s requires exactly one label\n", fs.Name())
+		return "", false
+	}
+	return positional[0], true
+}
+
+func runInit(args []string, jsonMode bool, stdout, stderr io.Writer) int {
+	fs := newFlagSet("init", &jsonMode, stderr)
+	enclave := fs.Bool("enclave", false, "store the pair in the Secure Enclave; refuses with -34018 on an unprovisioned binary")
+	keychain := fs.Bool("keychain", false, "store the pair in the login keychain (default)")
+	userPresence := fs.Bool("user-presence", false, "require biometry or passcode for private-key use; refuses with -34018 on an unprovisioned binary")
+	positional, err := parseInterspersed(fs, args)
+	if err != nil {
+		return exitUsage
+	}
+	out := output{command: "init", json: jsonMode, stdout: stdout, stderr: stderr}
+	if *enclave && *keychain {
+		fmt.Fprintln(stderr, "init accepts either --enclave or --keychain, not both")
+		return exitUsage
+	}
+	input, ok := singleLabel(fs, positional, stderr)
+	if !ok {
+		return exitUsage
+	}
+	label, err := keyvault.ResolveLabel(input)
+	if err != nil {
+		return out.fail(err)
+	}
+	store := keyvault.StoreKeychain
+	if *enclave {
+		store = keyvault.StoreEnclave
+	}
+	key, err := keyvault.NewManager(newBackend()).Init(label, store, *userPresence)
+	if err != nil {
+		return out.fail(err)
+	}
+	view := viewOf(key)
+	return out.success(view, func(w io.Writer) {
+		fmt.Fprintf(w, "created %s store=%s created=%s fingerprint=%s\n", view.Label, view.Store, view.Created, view.Fingerprint)
+	})
+}
+
+func runList(args []string, jsonMode bool, stdout, stderr io.Writer) int {
+	fs := newFlagSet("list", &jsonMode, stderr)
+	positional, err := parseInterspersed(fs, args)
+	if err != nil {
+		return exitUsage
+	}
+	out := output{command: "list", json: jsonMode, stdout: stdout, stderr: stderr}
+	if len(positional) != 0 {
+		fmt.Fprintln(stderr, "list takes no arguments")
+		return exitUsage
+	}
+	keys, err := keyvault.NewManager(newBackend()).List()
+	if err != nil {
+		return out.fail(err)
+	}
+	views := make([]keyView, 0, len(keys))
+	for _, key := range keys {
+		views = append(views, viewOf(key))
+	}
+	return out.success(views, func(w io.Writer) {
+		if len(views) == 0 {
+			fmt.Fprintln(w, "no keys under "+keyvault.LabelPrefix)
+			return
+		}
+		for _, view := range views {
+			created, fingerprint := view.Created, view.Fingerprint
+			if created == "" {
+				created = "unknown"
+			}
+			if fingerprint == "" {
+				fingerprint = "unknown"
+			}
+			fmt.Fprintf(w, "%s\t%s\t%s\t%s\n", view.Label, view.Store, created, fingerprint)
+		}
+	})
+}
+
+func runPub(args []string, jsonMode bool, stdout, stderr io.Writer) int {
+	fs := newFlagSet("pub", &jsonMode, stderr)
+	outPath := fs.String("out", "", "write the public key to PATH (.pem for PEM, anything else for SPKI DER)")
+	format := fs.String("format", "", "der or pem; default is inferred from --out, or pem on stdout")
+	positional, err := parseInterspersed(fs, args)
+	if err != nil {
+		return exitUsage
+	}
+	out := output{command: "pub", json: jsonMode, stdout: stdout, stderr: stderr}
+	input, ok := singleLabel(fs, positional, stderr)
+	if !ok {
+		return exitUsage
+	}
+	encoding, err := resolveFormat(*format, *outPath)
+	if err != nil {
+		fmt.Fprintln(stderr, err)
+		return exitUsage
+	}
+	label, err := keyvault.ResolveLabel(input)
+	if err != nil {
+		return out.fail(err)
+	}
+	key, err := keyvault.NewManager(newBackend()).Public(label)
+	if err != nil {
+		return out.fail(err)
+	}
+	if len(key.SPKI) == 0 {
+		return out.fail(fmt.Errorf("public key of %s is unreadable; fingerprint unknown", label))
+	}
+	payload := key.SPKI
+	if encoding == "pem" {
+		payload = keyvault.EncodePEM(key.SPKI)
+	}
+	result := struct {
+		keyView
+		Format string `json:"format"`
+		Out    string `json:"out,omitempty"`
+		PEM    string `json:"pem,omitempty"`
+	}{keyView: viewOf(key), Format: encoding, Out: *outPath}
+	if *outPath != "" {
+		if err := os.WriteFile(*outPath, payload, 0o600); err != nil {
+			return out.fail(err)
+		}
+		return out.success(result, func(w io.Writer) {
+			fmt.Fprintf(w, "wrote %s %s to %s fingerprint=%s\n", label, encoding, *outPath, result.Fingerprint)
+		})
+	}
+	if encoding == "der" && !jsonMode {
+		_, err := stdout.Write(payload)
+		if err != nil {
+			return out.fail(err)
+		}
+		return exitOK
+	}
+	result.PEM = string(keyvault.EncodePEM(key.SPKI))
+	return out.success(result, func(w io.Writer) { _, _ = w.Write(payload) })
+}
+
+func resolveFormat(format, outPath string) (string, error) {
+	switch strings.ToLower(format) {
+	case "der", "pem":
+		return strings.ToLower(format), nil
+	case "":
+		if strings.HasSuffix(strings.ToLower(outPath), ".pem") {
+			return "pem", nil
+		}
+		if outPath != "" {
+			return "der", nil
+		}
+		return "pem", nil
+	default:
+		return "", fmt.Errorf("--format must be der or pem, got %q", format)
+	}
+}
+
+func runRotate(args []string, jsonMode bool, stdout, stderr io.Writer) int {
+	fs := newFlagSet("rotate", &jsonMode, stderr)
+	positional, err := parseInterspersed(fs, args)
+	if err != nil {
+		return exitUsage
+	}
+	out := output{command: "rotate", json: jsonMode, stdout: stdout, stderr: stderr}
+	input, ok := singleLabel(fs, positional, stderr)
+	if !ok {
+		return exitUsage
+	}
+	label, err := keyvault.ResolveLabel(input)
+	if err != nil {
+		return out.fail(err)
+	}
+	rotated, err := keyvault.NewManager(newBackend()).Rotate(label)
+	if err != nil {
+		return out.fail(err)
+	}
+	result := struct {
+		Old keyView `json:"old"`
+		New keyView `json:"new"`
+	}{Old: viewOf(rotated.Old), New: viewOf(rotated.New)}
+	return out.success(result, func(w io.Writer) {
+		fmt.Fprintf(w, "rotated %s -> %s fingerprint=%s (old key kept until deleted)\n", result.Old.Label, result.New.Label, result.New.Fingerprint)
+	})
+}
+
+func runDelete(args []string, jsonMode bool, stdout, stderr io.Writer) int {
+	fs := newFlagSet("delete", &jsonMode, stderr)
+	confirm := fs.Bool("confirm", false, "acknowledge that the private key is destroyed irreversibly")
+	positional, err := parseInterspersed(fs, args)
+	if err != nil {
+		return exitUsage
+	}
+	out := output{command: "delete", json: jsonMode, stdout: stdout, stderr: stderr}
+	input, ok := singleLabel(fs, positional, stderr)
+	if !ok {
+		return exitUsage
+	}
+	label, err := keyvault.ResolveLabel(input)
+	if err != nil {
+		return out.fail(err)
+	}
+	if err := keyvault.NewManager(newBackend()).Delete(label, *confirm); err != nil {
+		return out.fail(err)
+	}
+	result := struct {
+		Label   string `json:"label"`
+		Deleted bool   `json:"deleted"`
+	}{Label: label, Deleted: true}
+	return out.success(result, func(w io.Writer) { fmt.Fprintf(w, "deleted %s\n", label) })
+}
+
+func printUsage(w io.Writer) {
+	fmt.Fprintf(w, `mac-keyvault manages non-extractable P-256 key pairs under %s in the login keychain.
+
+Usage:
+  mac-keyvault [--json] init <label> [--keychain|--enclave] [--user-presence]
+  mac-keyvault [--json] list
+  mac-keyvault [--json] pub <label> [--out spki.der|spki.pem] [--format der|pem]
+  mac-keyvault [--json] rotate <label>
+  mac-keyvault [--json] delete <label> --confirm
+  mac-keyvault version
+
+Labels are placed under the prefix automatically; a full label is accepted as is.
+--enclave and --user-presence refuse with OSStatus -34018 when the binary has no
+provisioning profile; there is no silent keychain fallback.
+
+Exit codes: 0 ok, 1 failure, 2 usage, 3 refused by a policy gate.
+`, keyvault.LabelPrefix)
+}
