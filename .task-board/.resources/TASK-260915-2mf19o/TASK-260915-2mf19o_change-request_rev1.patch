+
+func NewSecurityStore() *SecurityStore { return &SecurityStore{} }
+
+func (s *SecurityStore) Create(CreateOptions) (Key, error) {
+	return Key{}, fmt.Errorf("keyvault: Security.framework store requires darwin with cgo")
+}
+
+func (s *SecurityStore) List() ([]Key, error) {
+	return nil, fmt.Errorf("keyvault: Security.framework store requires darwin with cgo")
+}
+
+func (s *SecurityStore) Delete(string) error {
+	return fmt.Errorf("keyvault: Security.framework store requires darwin with cgo")
+}
