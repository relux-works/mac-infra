+// pub writes SPKI DER or PEM depending on --out / --format, both parse as the
+// same P-256 key, and JSON mode reports format, out, and fingerprint.
+func TestRunPubWritesDERAndPEM(t *testing.T) {
+	label := testPrefix + "cli-pub"
+	store := newMemStore(label)
+	useStore(t, store)
+	dir := t.TempDir()
+	derPath := filepath.Join(dir, "spki.der")
+	pemPath := filepath.Join(dir, "spki.pem")
+	forcedPEM := filepath.Join(dir, "spki.bin")
+
+	var stdout, stderr bytes.Buffer
+	if code := run([]string{"pub", label, "--out", derPath}, &stdout, &stderr); code != exitOK {
+		t.Fatalf("der: %d %s", code, stderr.String())
+	}
+	if code := run([]string{"pub", label, "--out", pemPath}, &stdout, &stderr); code != exitOK {
+		t.Fatalf("pem: %d %s", code, stderr.String())
+	}
+	code, resp, raw := runJSON(t, "pub", label, "--out", forcedPEM, "--format", "pem")
+	if code != exitOK {
+		t.Fatalf("forced pem: %s", raw)
+	}
+	result := resultMap(t, resp)
+	if result["format"] != "pem" || result["out"] != forcedPEM || result["fingerprint"] != store.keys[label].Fingerprint() {
+		t.Fatalf("result = %v", result)
+	}
+
+	der, err := os.ReadFile(derPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(der, store.keys[label].SPKI) {
+		t.Fatalf("der artifact differs from SPKI")
+	}
+	for _, path := range []string{pemPath, forcedPEM} {
+		data, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		block, _ := pem.Decode(data)
+		if block == nil || block.Type != "PUBLIC KEY" || !bytes.Equal(block.Bytes, der) {
+			t.Fatalf("%s is not the SPKI PEM: %s", path, data)
+		}
+		info, err := os.Stat(path)
+		if err != nil || info.Mode().Perm() != 0o600 {
+			t.Fatalf("%s mode = %v", path, info.Mode())
+		}
+	}
+	// stdout default is PEM; --format der streams raw DER.
+	stdout.Reset()
+	if code := run([]string{"pub", label}, &stdout, &stderr); code != exitOK || !strings.HasPrefix(stdout.String(), "-----BEGIN PUBLIC KEY-----") {
+		t.Fatalf("stdout pem: %d %q", code, stdout.String())
+	}
+	stdout.Reset()
+	if code := run([]string{"pub", label, "--format", "der"}, &stdout, &stderr); code != exitOK || !bytes.Equal(stdout.Bytes(), der) {
+		t.Fatalf("stdout der: %d %x", code, stdout.Bytes())
+	}
+	// JSON without --out embeds the PEM.
+	_, resp, _ = runJSON(t, "pub", label)
+	if pemText, _ := resultMap(t, resp)["pem"].(string); !strings.HasPrefix(pemText, "-----BEGIN PUBLIC KEY-----") {
+		t.Fatalf("json pem = %q", pemText)
+	}
+}
