diff --git a/internal/keyvault/security_darwin_test.go b/internal/keyvault/security_darwin_test.go
new file mode 100644
index 0000000..9651ee0
--- /dev/null
+++ b/internal/keyvault/security_darwin_test.go
@@ -0,0 +1,241 @@
+//go:build darwin && cgo
+
+package keyvault
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+// GuardedStore wraps a Backend and fails the test process before any Create
+// or Delete whose label is outside TestLabelPrefix reaches the real keychain.
+// Every integration test in this repository goes through it.
+type GuardedStore struct {
+	Backend
+	touched []string
+}
+
+// ErrGuardedLabel is returned when a test tries to touch a non-test label.
+var ErrGuardedLabel = errors.New("test guard: label outside " + TestLabelPrefix)
+
+func (g *GuardedStore) guard(label string) error {
+	if !strings.HasPrefix(label, TestLabelPrefix) || len(label) == len(TestLabelPrefix) {
+		return fmt.Errorf("%w: %q", ErrGuardedLabel, label)
+	}
+	g.touched = append(g.touched, label)
+	return nil
+}
+
+func (g *GuardedStore) Create(opts CreateOptions) (Key, error) {
+	if err := g.guard(opts.Label); err != nil {
+		return Key{}, err
+	}
+	return g.Backend.Create(opts)
+}
+
+func (g *GuardedStore) Delete(label string) error {
+	if err := g.guard(label); err != nil {
+		return err
+	}
+	return g.Backend.Delete(label)
+}
+
+func newGuardedSecurityStore(t *testing.T) *GuardedStore {
+	t.Helper()
+	store := &GuardedStore{Backend: NewSecurityStore()}
+	t.Cleanup(func() {
+		for _, label := range store.touched {
+			if err := store.Backend.Delete(label); err != nil && !errors.Is(err, ErrNotFound) {
+				t.Errorf("cleanup %s: %v", label, err)
+			}
+		}
+	})
+	return store
+}
+
+func testLabel(t *testing.T, suffix string) string {
+	return fmt.Sprintf("%s%d.%s", TestLabelPrefix, os.Getpid(), suffix)
+}
+
+// The guard itself refuses non-test labels (positive control for every
+// integration test below): a foreign or production-prefixed label never
+// reaches the wrapped backend.
+func TestGuardedStoreRefusesNonTestLabels(t *testing.T) {
+	inner := newFakeStore(LabelPrefix + "prod")
+	store := &GuardedStore{Backend: inner}
+	for _, label := range []string{LabelPrefix + "prod", "com.apple.security.key", TestLabelPrefix, ""} {
+		if _, err := store.Create(CreateOptions{Label: label, Store: StoreKeychain}); !errors.Is(err, ErrGuardedLabel) {
+			t.Fatalf("create %q: err = %v", label, err)
+		}
+		if err := store.Delete(label); !errors.Is(err, ErrGuardedLabel) {
+			t.Fatalf("delete %q: err = %v", label, err)
+		}
+	}
+	if len(inner.creates) != 0 || len(inner.deletes) != 0 {
+		t.Fatalf("guard leaked calls: creates=%v deletes=%v", inner.creates, inner.deletes)
+	}
+	if _, ok := inner.keys[LabelPrefix+"prod"]; !ok {
+		t.Fatal("production key was deleted through the guard")
+	}
+	if _, err := store.Create(CreateOptions{Label: TestLabelPrefix + "ok", Store: StoreKeychain}); err != nil {
+		t.Fatalf("test label refused: %v", err)
+	}
+}
+
+// Login-keychain round trip on this Mac: Create persists a P-256 pair whose
+// SPKI is a 91-byte DER, List returns it with the recorded creation time and
+// store, Delete removes both key halves so a second Delete is ErrNotFound.
+func TestSecurityStoreKeychainRoundTrip(t *testing.T) {
+	store := newGuardedSecurityStore(t)
+	label := testLabel(t, "roundtrip")
+	created := time.Date(2026, 9, 15, 9, 30, 0, 0, time.UTC)
+
+	key, err := store.Create(CreateOptions{Label: label, Store: StoreKeychain, Created: created})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(key.SPKI) != 91 || key.Fingerprint() == "" {
+		t.Fatalf("spki = %x", key.SPKI)
+	}
+
+	keys, err := store.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var listed *Key
+	for i := range keys {
+		if keys[i].Label == label {
+			listed = &keys[i]
+		}
+		if !strings.HasPrefix(keys[i].Label, LabelPrefix) {
+			t.Fatalf("bridge listed a foreign label %q", keys[i].Label)
+		}
+	}
+	if listed == nil {
+		t.Fatalf("created key missing from list: %+v", keys)
+	}
+	if listed.Store != StoreKeychain || !listed.Created.Equal(created) || listed.Fingerprint() != key.Fingerprint() {
+		t.Fatalf("listed = %+v, created = %+v", *listed, key)
+	}
+
+	if err := store.Delete(label); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.Delete(label); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("second delete err = %v, want ErrNotFound (a key half survived)", err)
+	}
+	keys, err = store.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range keys {
+		if key.Label == label {
+			t.Fatal("deleted key still listed")
+		}
+	}
+}
+
+// Creating the same label twice at the bridge level is possible in the legacy
+// keychain, which is why Manager.Init must gate duplicates itself; this test
+// pins that bound so the gate is not mistaken for a keychain guarantee.
+func TestSecurityStoreDoesNotRefuseDuplicateLabelsItself(t *testing.T) {
+	store := newGuardedSecurityStore(t)
+	label := testLabel(t, "dupbridge")
+	for i := 0; i < 2; i++ {
+		if _, err := store.Create(CreateOptions{Label: label, Store: StoreKeychain, Created: time.Now()}); err != nil {
+			t.Fatalf("create %d: %v", i, err)
+		}
+	}
+	manager := NewManager(store)
+	if _, err := manager.Init(label, StoreKeychain, false); refusalCode(t, err) != CodeDuplicateLabel {
+		t.Fatal("manager admitted the duplicate")
+	}
+	if err := store.Delete(label); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// On this unprovisioned binary the Secure Enclave and user-presence shapes
+// return exactly -34018 from Security.framework and leave no key behind.
+// Bound: on a binary signed with a provisioning profile these creates would
+// succeed and this test would report that as a failure to re-decide.
+func TestSecurityStoreEnclaveAndUserPresenceReturnMissingEntitlement(t *testing.T) {
+	store := newGuardedSecurityStore(t)
+	for name, opts := range map[string]CreateOptions{
+		"enclave":       {Store: StoreEnclave},
+		"user-presence": {Store: StoreKeychain, UserPresence: true},
+	} {
+		t.Run(name, func(t *testing.T) {
+			opts.Label = testLabel(t, name)
+			opts.Created = time.Now()
+			_, err := store.Create(opts)
+			var status *StatusError
+			if !errors.As(err, &status) || status.Status != errSecMissingEntitlement {
+				t.Fatalf("err = %v, want OSStatus -34018", err)
+			}
+			if err := store.Backend.Delete(opts.Label); !errors.Is(err, ErrNotFound) {
+				t.Fatalf("a key was persisted despite -34018: delete err = %v", err)
+			}
+		})
+	}
+}
+
+// Deleting a test label that does not exist is ErrNotFound rather than a
+// silent success.
+func TestSecurityStoreDeleteMissingIsNotFound(t *testing.T) {
+	store := newGuardedSecurityStore(t)
+	if err := store.Delete(testLabel(t, "never-created")); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("err = %v", err)
+	}
+}
+
+// The application tag carries store and creation time; an unknown tag maps to
+// StoreUnknown with a zero time instead of a guessed value.
+func TestTagEncoding(t *testing.T) {
+	created := time.Date(2026, 9, 15, 8, 0, 0, 0, time.UTC)
+	tag := encodeTag(CreateOptions{Store: StoreKeychain, Created: created})
+	if tag != "mac-keyvault/1 store=keychain created=2026-09-15T08:00:00Z" {
+		t.Fatalf("tag = %q", tag)
+	}
+	store, got := decodeTag(tag)
+	if store != StoreKeychain || !got.Equal(created) {
+		t.Fatalf("decode = %s %v", store, got)
+	}
+	for _, foreign := range []string{"", "something-else", "mac-keyvault/2 store=keychain", "mac-keyvault/1 created=garbage"} {
+		store, got := decodeTag(foreign)
+		if !got.IsZero() || store != StoreUnknown {
+			t.Fatalf("decodeTag(%q) = %s %v, want unknown", foreign, store, got)
+		}
+	}
+}
+
+// Bridge records are framed by US/RS bytes with a hex point; a truncated
+// record is an error, an unreadable point yields a key without SPKI, and a
+// point containing framing bytes survives because it is hex encoded.
+func TestParseListRecords(t *testing.T) {
+	gx := "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"
+	gy := "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"
+	record := func(label, tag, status, point string) string {
+		return label + "\x1f" + tag + "\x1f" + status + "\x1f" + point + "\x1e"
+	}
+	keys, err := parseListRecords([]byte(record(LabelPrefix+"a", "mac-keyvault/1 store=keychain created=2026-09-15T08:00:00Z", "0", "04"+gx+gy) + record(LabelPrefix+"b", "", "-2", "")))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(keys) != 2 || keys[0].Fingerprint() == "" || keys[1].Fingerprint() != "" || keys[1].Store != StoreUnknown {
+		t.Fatalf("keys = %+v", keys)
+	}
+	if _, err := parseListRecords([]byte("only\x1ftwo\x1e")); err == nil {
+		t.Fatal("truncated record accepted")
+	}
+	if _, err := parseListRecords([]byte(record(LabelPrefix+"c", "", "0", "zz"))); err == nil {
+		t.Fatal("malformed hex accepted")
+	}
+	if _, err := parseListRecords([]byte(record(LabelPrefix+"d", "", "0", "04"+gx+gx))); err == nil {
+		t.Fatal("off-curve point accepted")
+	}
+}
