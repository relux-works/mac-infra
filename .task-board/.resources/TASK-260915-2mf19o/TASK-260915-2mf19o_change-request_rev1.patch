+const testPrefix = keyvault.TestLabelPrefix
+
+// memStore is an in-memory Backend that records every call, so CLI tests can
+// prove which labels reached the store and which refusals happened first.
+type memStore struct {
+	keys    map[string]keyvault.Key
+	creates []keyvault.CreateOptions
+	deletes []string
+	createE error
+}
+
+func newMemStore(labels ...string) *memStore {
+	s := &memStore{keys: map[string]keyvault.Key{}}
+	for i, label := range labels {
+		s.keys[label] = keyvault.Key{Label: label, Store: keyvault.StoreKeychain, Created: time.Date(2026, 9, 15, 8, i, 0, 0, time.UTC), SPKI: generatorSPKI(byte(i))}
+	}
+	return s
+}
+
+func (s *memStore) Create(opts keyvault.CreateOptions) (keyvault.Key, error) {
+	s.creates = append(s.creates, opts)
+	if s.createE != nil {
+		return keyvault.Key{}, s.createE
+	}
+	key := keyvault.Key{Label: opts.Label, Store: opts.Store, Created: opts.Created, SPKI: generatorSPKI(byte(len(s.creates) + 100))}
+	s.keys[opts.Label] = key
+	return key, nil
+}
+
+func (s *memStore) List() ([]keyvault.Key, error) {
+	out := make([]keyvault.Key, 0, len(s.keys))
+	for _, key := range s.keys {
+		out = append(out, key)
+	}
+	return out, nil
+}
+
+func (s *memStore) Delete(label string) error {
+	s.deletes = append(s.deletes, label)
+	if _, ok := s.keys[label]; !ok {
+		return keyvault.ErrNotFound
+	}
+	delete(s.keys, label)
+	return nil
+}
+
+// generatorSPKI is a valid P-256 SPKI (the generator point) with one byte of
+// the DER header varied so fingerprints differ per key.
+func generatorSPKI(salt byte) []byte {
+	block, _ := pem.Decode([]byte(`-----BEGIN PUBLIC KEY-----
+MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEaxfR8uEsQkf4vOblY6RA8ncDfYEt
+6zOg9KE5RdiYwpZP40Lj/v4fp7juftIhGzOaI8+9gMJ8+/e/g+3IbJOJnw==
+-----END PUBLIC KEY-----`))
+	out := append([]byte(nil), block.Bytes...)
+	out[len(out)-1] ^= salt
+	return out
+}
+
+func useStore(t *testing.T, store keyvault.Backend) {
+	t.Helper()
+	previous := newBackend
+	newBackend = func() keyvault.Backend { return store }
+	t.Cleanup(func() { newBackend = previous })
+}
+
+func runJSON(t *testing.T, args ...string) (int, response, string) {
+	t.Helper()
+	var stdout, stderr bytes.Buffer
+	code := run(append([]string{"--json"}, args...), &stdout, &stderr)
+	var resp response
+	if err := json.Unmarshal(stdout.Bytes(), &resp); err != nil {
+		t.Fatalf("stdout is not a JSON envelope (%v): %s / stderr: %s", err, stdout.String(), stderr.String())
+	}
+	if stderr.Len() != 0 {
+		t.Fatalf("json mode wrote to stderr: %s", stderr.String())
+	}
+	return code, resp, stdout.String()
+}
+
+func resultMap(t *testing.T, resp response) map[string]any {
+	t.Helper()
+	m, ok := resp.Result.(map[string]any)
+	if !ok {
+		t.Fatalf("result is %T, want object: %+v", resp.Result, resp.Result)
+	}
+	return m
+}
