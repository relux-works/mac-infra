+	plan := makeTestPlan(t, root, candidatePath, generatedAt)
+
+	result := ValidatePlanForApply(plan, generatedAt.Add(DefaultPlanStaleAfter).Add(time.Second))
+	if result.Allowed() {
+		t.Fatal("stale plan was allowed")
+	}
