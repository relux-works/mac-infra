+}
+
+type CandidateRevalidationPolicy struct {
+	ReLstatBeforeDelete        bool     `json:"reLstatBeforeDelete"`
+	RefuseSymlinkSwap          bool     `json:"refuseSymlinkSwap"`
+	RefuseOutOfRoot            bool     `json:"refuseOutOfRoot"`
