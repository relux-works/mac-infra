+		RealPath:     filepath.Clean(candidate.Identity.RealPath),
+		RootRealPath: filepath.Clean(candidate.Identity.RootRealPath),
+		Device:       candidate.Identity.Device,
+		Inode:        candidate.Identity.Inode,
