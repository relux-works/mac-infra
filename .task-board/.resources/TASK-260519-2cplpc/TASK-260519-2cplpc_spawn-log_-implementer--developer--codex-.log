+	StaleAfterSeconds     int64             `json:"staleAfterSeconds"`
+	Source                PlanSource        `json:"source"`
+	Root                  PlanRoot          `json:"root"`
+	Categories            []PlanCategory    `json:"categories,omitempty"`
+	Candidates            []Candidate       `json:"candidates"`
