+}
+
+type NewCandidateInput struct {
+	Path            string
+	RootPath        string
+	CategoryID      CategoryID
+	Reason          string
+	Risk            RiskLevel
+	DefaultSelected bool
+	Selected        bool
+}
+
+type NewPlanInput struct {
