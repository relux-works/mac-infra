+
+	result := RevalidatePlanCandidates(plan, RevalidationOptions{
+		CurrentUID:    uint32(os.Getuid()),
+		CurrentUIDSet: true,
+		SelectedOnly:  true,
+		CheckedAt:     generatedAt.Add(time.Hour),
+	})
+	if result.Allowed() {
+		t.Fatal("symlink-swapped candidate was allowed")
