+
+func TestRevalidatePlanCandidatesRefusesChangedCandidateBeforeDeletion(t *testing.T) {
+	root, candidatePath := makeCleanupFixture(t, "cache data")
+	generatedAt := time.Date(2026, 5, 19, 12, 30, 0, 0, time.UTC)
