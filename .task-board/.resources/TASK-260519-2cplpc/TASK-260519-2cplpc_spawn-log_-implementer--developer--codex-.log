+	generatedAt := time.Date(2026, 5, 19, 12, 30, 0, 0, time.UTC)
+	plan := makeTestPlan(t, root, candidatePath, generatedAt)
+	plan.Candidates[0].Identity.UID = uint32(os.Getuid()) + 1
+	var err error
