+func printJSON(stdout, stderr io.Writer, value any) int {
+	data, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		fmt.Fprintln(stderr, err)
+		return 1
+	}
+	_, _ = stdout.Write(append(data, '\n'))
+	return 0
+}
