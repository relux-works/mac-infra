+func (m HeartbeatManager) ResolveDeadline(ttl time.Duration, raw string) (time.Time, error) {
+	raw = strings.TrimSpace(raw)
+	if (ttl > 0) == (raw != "") {
+		return time.Time{}, errors.New("heartbeat requires exactly one of a positive --ttl or --deadline")
