+		if code != 0 {
+			t.Fatalf("run %v code = %d, stderr = %s", args, code, stderr.String())
+		}
+	}
+
+	after := snapshotPath(t, target)
+	if after != before {
+		t.Fatalf("file metadata changed: before=%#v after=%#v", before, after)
+	}
+}
