 package diskprofile
 
 import (
+	"bytes"
 	"context"
 	"encoding/json"
 	"errors"
 	"fmt"
 	"os"
 	"path/filepath"
+	"strings"
 	"testing"
 	"time"
 )
 
+func TestScanAggregatesFixtureTreeAndRanksTopEntries(t *testing.T) {
+	root := t.TempDir()
+	fixture := scanFixture{
+		dirs: []string{
+			"Applications",
+			"Logs",
+			"Logs/archive",
