+	const secretKey = "xoxb-12345678-keyvalue"
+	response := `{"` + secretKey + `":"first-value","` + secretKey + `":"second-value"}`
+
+	result, err := slackReadProductionResult(t, response)
+	if kind := SlackReadErrorKind(err); kind != "response-key-collision" {
