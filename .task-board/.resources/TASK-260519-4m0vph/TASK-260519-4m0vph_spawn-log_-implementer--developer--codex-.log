   406	func (policy RootSafetyPolicy) EvaluateRoot(path string, homeDir string) RootDecision {
   407		cleanPath := filepath.Clean(path)
   408		decision := RootDecision{
   409			Path:                        cleanPath,
   410			Allowed:                     true,
   411			RequiresOwnershipCheck:      policy.RequireUserOwnedRoots,
   412			RequiresSymlinkCheck:        policy.RefuseSymlinkRoots,
   413			RequiresRealpathContainment: policy.RequireRealpathContainment,
   414		}
