   424		if policy.ExternalVolumes.RefuseVolumesRoot && cleanPath == volumeRoot {
   425			decision.Allowed = false
   426			decision.Dangerous = true
   427			decision.Reason = "external volume mount root is never a cleanup target"
   428			return decision
   429		}
   430	
   431		if volumeName, rest, ok := splitExternalVolumePath(cleanPath, volumeRoot); ok {
