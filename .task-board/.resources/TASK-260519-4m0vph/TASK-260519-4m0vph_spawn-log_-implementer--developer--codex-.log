+				"*.log.*.gz",
+				"*.log.*.bz2",
+				"*.log.*.xz",
+				"*.log.*.zip",
+				"*.old",
+			},
+			MinimumAgeDays: 14,
+		},
+	}
+}
+
+func ReviewOnlyCategories() []Category {
+	return []Category{
+		{
+			ID:              CategoryDownloads,
+			Title:           "Downloads",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
