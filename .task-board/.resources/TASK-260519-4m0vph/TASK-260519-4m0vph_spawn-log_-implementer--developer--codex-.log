+			Reason:          "Downloads often contain intentionally saved user data and must be selected by the user.",
+			Roots: []RootSpec{
+				{Path: "~/Downloads", Scope: RootScopeHome, Recursive: true},
+			},
+		},
+		{
+			ID:              CategoryLargeFiles,
+			Title:           "Large files",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
+			Summary:         "Large user files discovered by size heuristics.",
+			Reason:          "Size does not imply disposable data; deletion requires human review.",
+			Roots: []RootSpec{
+				{Path: "<scan-result>", Scope: RootScopeVirtual, Recursive: false},
+			},
+		},
+		{
+			ID:              CategoryOldFiles,
+			Title:           "Old files",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
+			Summary:         "Old user files discovered by age heuristics.",
+			Reason:          "Age does not imply disposable data; deletion requires human review.",
+			Roots: []RootSpec{
+				{Path: "<scan-result>", Scope: RootScopeVirtual, Recursive: false},
+			},
+		},
+		{
+			ID:              CategoryAppCaches,
+			Title:           "App caches",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
+			Summary:         "Application caches under the user's Library.",
+			Reason:          "App caches can contain offline state, account state, expensive regenerated data, or app-specific semantics.",
+			Roots: []RootSpec{
+				{Path: "~/Library/Caches", Scope: RootScopeHome, Recursive: true},
+			},
+		},
+		{
+			ID:              CategoryIOSBackups,
+			Title:           "iOS device backups",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
+			Summary:         "Local iPhone and iPad backups.",
+			Reason:          "Backups protect user data and may be the only recovery copy.",
+			Roots: []RootSpec{
+				{Path: "~/Library/Application Support/MobileSync/Backup", Scope: RootScopeHome, Recursive: true},
+			},
+		},
+		{
+			ID:              CategoryXcodeArchives,
+			Title:           "Xcode Archives",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
+			Summary:         "Archived builds produced by Xcode.",
+			Reason:          "Archives can be needed for distribution, dSYM symbolication, or release reproducibility.",
+			Roots: []RootSpec{
+				{Path: "~/Library/Developer/Xcode/Archives", Scope: RootScopeHome, Recursive: true},
+			},
+		},
+		{
+			ID:              CategoryXcodeDeviceSupport,
+			Title:           "Xcode DeviceSupport",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
+			Summary:         "Device support files installed for connected devices.",
+			Reason:          "DeviceSupport may be needed for debugging or symbolication on specific OS/device combinations.",
+			Roots: []RootSpec{
+				{Path: "~/Library/Developer/Xcode/DeviceSupport", Scope: RootScopeHome, Recursive: true},
+				{Path: "~/Library/Developer/Xcode/iOS DeviceSupport", Scope: RootScopeHome, Recursive: true},
+			},
+		},
+		{
+			ID:              CategoryXcodeSimulators,
+			Title:           "Xcode simulators",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
+			Summary:         "Installed simulator devices and their data.",
+			Reason:          "Simulators contain runtimes, installed apps, and test data; deletion can disrupt development workflows.",
+			Roots: []RootSpec{
