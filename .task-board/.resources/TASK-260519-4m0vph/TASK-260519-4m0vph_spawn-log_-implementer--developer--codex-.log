   434				decision.Dangerous = true
   435				decision.Reason = "external volume root " + volumeName + " is never default-selected or cleaned as a whole"
   436				return decision
   437			}
   438	
   439			decision.ExternalVolumeChild = true
   440			decision.RequiresExplicitTarget = policy.ExternalVolumes.RequireExplicitTargetForChildPaths
   441			if !policy.ExternalVolumes.AllowChildPaths {
   442				decision.Allowed = false
   443				decision.Dangerous = true
   444				decision.Reason = "external volume child paths are disabled by policy"
   445			}
   446		}
   447	
   448		return decision
   449	}
