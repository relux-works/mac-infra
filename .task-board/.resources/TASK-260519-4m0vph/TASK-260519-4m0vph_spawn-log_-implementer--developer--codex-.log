+	Recursive              bool
+	RequiresExplicitTarget bool
+}
+
+type Category struct {
+	ID              CategoryID
+	Title           string
+	Risk            RiskLevel
+	DefaultSelected bool
+	Summary         string
+	Reason          string
+	Roots           []RootSpec
+	Patterns        []string
+	MinimumAgeDays  int
+}
+
+type Policy struct {
+	Categories []Category
+	Safety     RootSafetyPolicy
+}
+
+type DangerousRoot struct {
