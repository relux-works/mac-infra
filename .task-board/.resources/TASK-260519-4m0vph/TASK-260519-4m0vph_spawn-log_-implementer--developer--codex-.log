+			Reason:          "Age does not imply disposable data; deletion requires human review.",
+			Roots: []RootSpec{
+				{Path: "<scan-result>", Scope: RootScopeVirtual, Recursive: false},
+			},
+		},
+		{
+			ID:              CategoryAppCaches,
+			Title:           "App caches",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
+			Summary:         "Application caches under the user's Library.",
+			Reason:          "App caches can contain offline state, account state, expensive regenerated data, or app-specific semantics.",
+			Roots: []RootSpec{
+				{Path: "~/Library/Caches", Scope: RootScopeHome, Recursive: true},
+			},
+		},
+		{
+			ID:              CategoryIOSBackups,
+			Title:           "iOS device backups",
+			Risk:            RiskReviewOnly,
+			DefaultSelected: false,
