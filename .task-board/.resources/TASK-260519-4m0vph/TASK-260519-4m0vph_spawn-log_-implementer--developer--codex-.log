   451	func (policy RootSafetyPolicy) matchDangerousRoot(path string, homeDir string) (DangerousRoot, bool) {
   452		cleanHome := filepath.Clean(homeDir)
   453		for _, root := range policy.DangerousRoots {
   454			if root.Path == "$HOME" {
   455				if homeDir != "" && path == cleanHome {
   456					return root, true
   457				}
   458				continue
   459			}
   460			rootPath := filepath.Clean(root.Path)
   461			if path == rootPath || root.RejectDescendants && hasPathPrefix(path, rootPath) {
   462				return root, true
   463			}
   464		}
   465		return DangerousRoot{}, false
   466	}
   467	
   468	func hasPathPrefix(path string, root string) bool {
   469		if root == string(filepath.Separator) {
   470			return false
   471		}
   472		return strings.HasPrefix(path, root+string(filepath.Separator))
   473	}
   474	
   475	func splitExternalVolumePath(path string, volumeRoot string) (volumeName string, rest string, ok bool) {
   476		prefix := volumeRoot + string(filepath.Separator)
   477		if !strings.HasPrefix(path, prefix) {
   478			return "", "", false
   479		}
   480	
   481		remaining := strings.TrimPrefix(path, prefix)
   482		parts := strings.SplitN(remaining, string(filepath.Separator), 2)
   483		if parts[0] == "" {
   484			return "", "", false
   485		}
   486		if len(parts) == 1 {
   487			return parts[0], "", true
   488		}
   489		return parts[0], parts[1], true
   490	}

