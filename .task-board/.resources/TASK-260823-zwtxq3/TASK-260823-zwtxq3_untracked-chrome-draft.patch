+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestUsageDocumentsHeartbeatLifecycle(t *testing.T) {
+	var stdout, stderr bytes.Buffer
+	if code := run([]string{"help"}, &stdout, &stderr); code != 0 {
+		t.Fatalf("code = %d stderr=%s", code, stderr.String())
+	}
+	for _, want := range []string{"run-js", "heartbeat start|status|stop", "list"} {
+		if !strings.Contains(stdout.String(), want) {
+			t.Fatalf("usage missing %q:\n%s", want, stdout.String())
+		}
+	}
+}
+
+func TestRunJSRequiresExactIDsAndScript(t *testing.T) {
+	var stdout, stderr bytes.Buffer
+	if code := run([]string{"run-js", "--script", "document.title"}, &stdout, &stderr); code != 2 {
+		t.Fatalf("code = %d, want 2", code)
+	}
+	if !strings.Contains(stderr.String(), "--window-id") {
+		t.Fatalf("stderr = %q", stderr.String())
+	}
+}
diff --git a/internal/chromectl/session.go b/internal/chromectl/session.go
new file mode 100644
index 0000000..185d10b
--- /dev/null
+++ b/internal/chromectl/session.go
@@ -0,0 +1,365 @@
+package chromectl
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/relux-works/mac-infra/internal/safarictl"
+)
+
+const (
+	DefaultStateDir = "Library/Application Support/mac-infra/chrome-session"
+	labelPrefix     = "works.relux.mac-infra-chrome-heartbeat."
+)
+
+var heartbeatNamePattern = regexp.MustCompile(`^[a-z0-9][a-z0-9-]{0,47}$`)
+
+type Session struct {
+	OsaScriptPath string
+}
+
+type Tab struct {
+	WindowID string `json:"windowId"`
+	TabID    string `json:"tabId"`
+	Title    string `json:"title"`
+	URL      string `json:"url"`
+	Origin   string `json:"origin,omitempty"`
+}
+
+type HeartbeatConfig struct {
+	Name       string        `json:"name"`
+	WindowID   string        `json:"windowId"`
+	TabID      string        `json:"tabId"`
+	Origin     string        `json:"origin"`
+	Interval   time.Duration `json:"interval"`
+	Executable string        `json:"executable"`
+	Label      string        `json:"label"`
+	PlistPath  string        `json:"plistPath"`
+	LogPath    string        `json:"logPath"`
+	StatePath  string        `json:"statePath"`
+	UID        int           `json:"uid"`
+}
+
+type HeartbeatStatus struct {
+	Name      string `json:"name"`
+	State     string `json:"state"`
+	Label     string `json:"label"`
+	WindowID  string `json:"windowId,omitempty"`
+	TabID     string `json:"tabId,omitempty"`
+	Origin    string `json:"origin,omitempty"`
+	Interval  string `json:"interval,omitempty"`
+	PlistPath string `json:"plistPath"`
+	LogPath   string `json:"logPath"`
+}
+
+func New() Session {
+	return Session{OsaScriptPath: "/usr/bin/osascript"}
+}
+
+func (s Session) List(ctx context.Context) ([]Tab, error) {
+	out, err := s.runJXA(ctx, listJXA())
+	if err != nil {
+		return nil, err
+	}
+	var windows []struct {
+		ID   string `json:"id"`
+		Tabs []struct {
+			ID    string `json:"id"`
+			Title string `json:"title"`
+			URL   string `json:"url"`
+		} `json:"tabs"`
+	}
+	if err := json.Unmarshal([]byte(out), &windows); err != nil {
+		return nil, fmt.Errorf("decode Chrome windows: %w", err)
+	}
+	var tabs []Tab
+	for _, window := range windows {
+		for _, tab := range window.Tabs {
+			redacted := redactTabURL(tab.URL)
+			tabs = append(tabs, Tab{WindowID: window.ID, TabID: tab.ID, Title: tab.Title, URL: redacted, Origin: originOf(redacted)})
+		}
+	}
+	return tabs, nil
+}
+
+func (s Session) RunJavaScript(ctx context.Context, windowID, tabID, expectedOrigin, source string) (string, error) {
+	if strings.TrimSpace(windowID) == "" || strings.TrimSpace(tabID) == "" {
+		return "", errors.New("window id and tab id are required")
+	}
+	if err := safarictl.GuardJavaScript(source); err != nil {
+		return "", err
+	}
+	expectedOrigin = strings.TrimSpace(expectedOrigin)
+	if expectedOrigin != "" {
+		actual, err := s.runJXA(ctx, executeJXA(), windowID, tabID, "location.origin")
+		if err != nil {
+			return "", err
+		}
+		if strings.TrimSpace(actual) != expectedOrigin {
+			return "", fmt.Errorf("Chrome target origin changed: got %q, want %q", strings.TrimSpace(actual), expectedOrigin)
+		}
+	}
+	return s.runJXA(ctx, executeJXA(), windowID, tabID, source)
+}
+
+func HeartbeatJavaScript() string {
+	return `(() => {
+  const target = document.querySelector("textarea,input,[contenteditable=true]") || document.body || document.documentElement;
+  target.dispatchEvent(new PointerEvent("pointermove", {bubbles:true, clientX:1, clientY:1}));
+  target.dispatchEvent(new KeyboardEvent("keydown", {bubbles:true, key:"Shift", code:"ShiftLeft"}));
+  target.dispatchEvent(new KeyboardEvent("keyup", {bubbles:true, key:"Shift", code:"ShiftLeft"}));
+  return JSON.stringify({ok:true,title:document.title,origin:location.origin,readyState:document.readyState});
+})()`
+}
+
+func DefaultHeartbeatConfig(name, windowID, tabID, origin, executable string, interval time.Duration) (HeartbeatConfig, error) {
+	if !heartbeatNamePattern.MatchString(name) {
+		return HeartbeatConfig{}, errors.New("heartbeat name must match [a-z0-9][a-z0-9-]{0,47}")
+	}
+	if strings.TrimSpace(windowID) == "" || strings.TrimSpace(tabID) == "" || strings.TrimSpace(origin) == "" {
+		return HeartbeatConfig{}, errors.New("heartbeat requires window id, tab id, and expected origin")
+	}
+	if interval < 15*time.Second {
+		return HeartbeatConfig{}, errors.New("heartbeat interval must be at least 15s")
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return HeartbeatConfig{}, fmt.Errorf("resolve user home: %w", err)
+	}
+	stateDir := filepath.Join(home, DefaultStateDir)
+	label := labelPrefix + name
+	return HeartbeatConfig{
+		Name: name, WindowID: windowID, TabID: tabID, Origin: origin, Interval: interval,
+		Executable: executable, Label: label, UID: os.Getuid(),
+		PlistPath: filepath.Join(home, "Library", "LaunchAgents", label+".plist"),
+		LogPath:   filepath.Join(stateDir, name+".log"), StatePath: filepath.Join(stateDir, name+".json"),
+	}, nil
+}
+
+func (s Session) StartHeartbeat(ctx context.Context, cfg HeartbeatConfig) error {
+	if _, err := s.RunJavaScript(ctx, cfg.WindowID, cfg.TabID, cfg.Origin, HeartbeatJavaScript()); err != nil {
+		return fmt.Errorf("heartbeat preflight: %w", err)
+	}
+	if err := os.MkdirAll(filepath.Dir(cfg.StatePath), 0o700); err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(cfg.PlistPath), 0o700); err != nil {
+		return err
+	}
+	if err := os.WriteFile(cfg.LogPath, nil, 0o600); err != nil {
+		return err
+	}
+	state, _ := json.MarshalIndent(cfg, "", "  ")
+	state = append(state, '\n')
+	if err := writeAtomic(cfg.StatePath, state, 0o600); err != nil {
+		return err
+	}
+	if err := writeAtomic(cfg.PlistPath, RenderHeartbeatLaunchAgent(cfg), 0o600); err != nil {
+		return err
+	}
+	service := "gui/" + strconv.Itoa(cfg.UID) + "/" + cfg.Label
+	_ = runLaunchctl(ctx, "bootout", service)
+	return runLaunchctl(ctx, "bootstrap", "gui/"+strconv.Itoa(cfg.UID), cfg.PlistPath)
+}
+
+func StopHeartbeat(ctx context.Context, name string) error {
+	cfg, err := LoadHeartbeatConfig(name)
+	if err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	if os.IsNotExist(err) {
+		template, cfgErr := DefaultHeartbeatConfig(name, "x", "x", "x", "x", 15*time.Second)
+		if cfgErr != nil {
+			return cfgErr
+		}
+		cfg = template
+	}
+	service := "gui/" + strconv.Itoa(cfg.UID) + "/" + cfg.Label
+	if launchErr := runLaunchctl(ctx, "bootout", service); launchErr != nil && !isMissingLaunchAgent(launchErr) {
+		return launchErr
+	}
+	_ = os.Remove(cfg.PlistPath)
+	_ = os.Remove(cfg.StatePath)
+	return nil
+}
+
+func InspectHeartbeat(ctx context.Context, name string) (HeartbeatStatus, error) {
+	cfg, err := LoadHeartbeatConfig(name)
+	if err != nil {
+		if os.IsNotExist(err) {
+			template, cfgErr := DefaultHeartbeatConfig(name, "x", "x", "x", "x", 15*time.Second)
+			if cfgErr != nil {
+				return HeartbeatStatus{}, cfgErr
+			}
+			return HeartbeatStatus{Name: name, State: "stopped", Label: template.Label, PlistPath: template.PlistPath, LogPath: template.LogPath}, nil
+		}
+		return HeartbeatStatus{}, err
+	}
+	status := HeartbeatStatus{Name: name, State: "stopped", Label: cfg.Label, WindowID: cfg.WindowID, TabID: cfg.TabID, Origin: cfg.Origin, Interval: cfg.Interval.String(), PlistPath: cfg.PlistPath, LogPath: cfg.LogPath}
+	service := "gui/" + strconv.Itoa(cfg.UID) + "/" + cfg.Label
+	if err := runLaunchctl(ctx, "print", service); err == nil {
+		status.State = "running"
+	} else if !isMissingLaunchAgent(err) {
+		status.State = "unavailable"
+		return status, err
+	}
+	return status, nil
+}
+
+func LoadHeartbeatConfig(name string) (HeartbeatConfig, error) {
+	template, err := DefaultHeartbeatConfig(name, "x", "x", "x", "x", 15*time.Second)
+	if err != nil {
+		return HeartbeatConfig{}, err
+	}
+	data, err := os.ReadFile(template.StatePath)
+	if err != nil {
+		return HeartbeatConfig{}, err
+	}
+	var cfg HeartbeatConfig
+	if err := json.Unmarshal(data, &cfg); err != nil {
+		return HeartbeatConfig{}, err
+	}
+	return cfg, nil
+}
+
+func (s Session) RunHeartbeat(ctx context.Context, cfg HeartbeatConfig) error {
+	ticker := time.NewTicker(cfg.Interval)
+	defer ticker.Stop()
+	for {
+		started := time.Now().UTC()
+		probeCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
+		result, err := s.RunJavaScript(probeCtx, cfg.WindowID, cfg.TabID, cfg.Origin, HeartbeatJavaScript())
+		cancel()
+		if err != nil {
+			fmt.Fprintf(os.Stdout, "%s error=%q\n", started.Format(time.RFC3339), err.Error())
+		} else {
+			fmt.Fprintf(os.Stdout, "%s result=%q\n", started.Format(time.RFC3339), result)
+		}
+		select {
+		case <-ctx.Done():
+			return nil
+		case <-ticker.C:
+		}
+	}
+}
+
+func RenderHeartbeatLaunchAgent(cfg HeartbeatConfig) []byte {
+	args := []string{cfg.Executable, "heartbeat", "run", "--name", cfg.Name}
+	var b strings.Builder
+	b.WriteString("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n")
+	b.WriteString("  <key>Label</key><string>" + xmlEscape(cfg.Label) + "</string>\n  <key>ProgramArguments</key><array>\n")
+	for _, arg := range args {
+		b.WriteString("    <string>" + xmlEscape(arg) + "</string>\n")
+	}
+	b.WriteString("  </array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>Umask</key><integer>63</integer>\n")
+	b.WriteString("  <key>StandardOutPath</key><string>" + xmlEscape(cfg.LogPath) + "</string>\n  <key>StandardErrorPath</key><string>" + xmlEscape(cfg.LogPath) + "</string>\n</dict>\n</plist>\n")
+	return []byte(b.String())
+}
+
+func listJXA() string {
+	return `const c=Application("Google Chrome"); JSON.stringify(c.windows().map(w=>({id:String(w.id()),tabs:w.tabs().map(t=>({id:String(t.id()),title:String(t.title()||""),url:String(t.url()||"")}))})))`
+}
+
+func executeJXA() string {
+	return `function run(argv){const c=Application("Google Chrome");const ws=c.windows.whose({id:String(argv[0])})();if(!ws.length)throw new Error("Chrome target window is no longer open");const ts=ws[0].tabs.whose({id:String(argv[1])})();if(!ts.length)throw new Error("Chrome target tab is no longer open");return c.execute(ts[0],{javascript:String(argv[2])});}`
+}
+
+func (s Session) runJXA(ctx context.Context, script string, args ...string) (string, error) {
+	path := strings.TrimSpace(s.OsaScriptPath)
+	if path == "" {
+		path = "/usr/bin/osascript"
+	}
+	cmdArgs := []string{"-l", "JavaScript", "-e", script}
+	cmdArgs = append(cmdArgs, args...)
+	cmd := exec.CommandContext(ctx, path, cmdArgs...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	if err := cmd.Run(); err != nil {
+		detail := strings.TrimSpace(stderr.String())
+		if detail == "" {
+			detail = err.Error()
+		}
+		return "", fmt.Errorf("Chrome Apple Events failed: %s", detail)
+	}
+	return strings.TrimRight(stdout.String(), "\n"), nil
+}
+
+func originOf(raw string) string {
+	for _, prefix := range []string{"https://", "http://"} {
+		if strings.HasPrefix(raw, prefix) {
+			rest := strings.TrimPrefix(raw, prefix)
+			if i := strings.IndexAny(rest, "/?#"); i >= 0 {
+				rest = rest[:i]
+			}
+			return prefix + rest
+		}
+	}
+	return ""
+}
+
+func redactTabURL(raw string) string {
+	redacted := safarictl.RedactSensitiveURL(raw)
+	parsed, err := url.Parse(redacted)
+	if err != nil {
+		return redacted
+	}
+	if parsed.Fragment != "" {
+		parsed.Fragment = "[redacted]"
+	}
+	return parsed.String()
+}
+
+func writeAtomic(path string, data []byte, mode os.FileMode) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(path), ".tmp-*")
+	if err != nil {
+		return err
+	}
+	name := tmp.Name()
+	defer os.Remove(name)
+	if err := tmp.Chmod(mode); err != nil {
+		_ = tmp.Close()
+		return err
+	}
+	if _, err := tmp.Write(data); err != nil {
+		_ = tmp.Close()
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	return os.Rename(name, path)
+}
+
+func runLaunchctl(ctx context.Context, args ...string) error {
+	cmd := exec.CommandContext(ctx, "/bin/launchctl", args...)
+	var output bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &output, &output
+	if err := cmd.Run(); err != nil {
+		return fmt.Errorf("launchctl %s: %s", strings.Join(args, " "), strings.TrimSpace(output.String()))
+	}
+	return nil
+}
+
+func isMissingLaunchAgent(err error) bool {
+	text := strings.ToLower(err.Error())
+	return strings.Contains(text, "could not find service") || strings.Contains(text, "service not found") || strings.Contains(text, "no such process") || strings.Contains(text, "113")
+}
+
+func xmlEscape(value string) string {
+	replacer := strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;", "\"", "&quot;", "'", "&apos;")
+	return replacer.Replace(value)
+}
