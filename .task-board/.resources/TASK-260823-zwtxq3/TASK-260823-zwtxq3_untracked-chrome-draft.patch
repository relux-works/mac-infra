+
+func TestHeartbeatJavaScriptDoesNotFocusChromeOrReadSecrets(t *testing.T) {
+	source := HeartbeatJavaScript()
+	for _, forbidden := range []string{"document.cookie", "localStorage", "sessionStorage", "activate", "active tab"} {
+		if strings.Contains(source, forbidden) {
+			t.Fatalf("heartbeat contains forbidden token %q", forbidden)
+		}
+	}
+	for _, want := range []string{"pointermove", "ShiftLeft", "location.origin"} {
+		if !strings.Contains(source, want) {
+			t.Fatalf("heartbeat missing %q", want)
+		}
+	}
+}
+
+func TestRenderHeartbeatLaunchAgentPinsExactTargetThroughStateName(t *testing.T) {
+	cfg := HeartbeatConfig{Name: "fns", Label: "works.relux.test.fns", Executable: "/tmp/mac-chrome-session", LogPath: "/tmp/fns.log"}
+	plist := string(RenderHeartbeatLaunchAgent(cfg))
+	for _, want := range []string{"/tmp/mac-chrome-session", "heartbeat", "run", "--name", "fns", "<key>Umask</key><integer>63</integer>", "/tmp/fns.log"} {
+		if !strings.Contains(plist, want) {
+			t.Fatalf("plist missing %q:\n%s", want, plist)
+		}
+	}
+	for _, forbidden := range []string{"activate", "System Events", "set active tab"} {
+		if strings.Contains(plist, forbidden) {
+			t.Fatalf("plist contains focus mutation %q", forbidden)
+		}
+	}
+}
+
+func TestDefaultHeartbeatConfigRejectsUnsafeNameAndFastInterval(t *testing.T) {
+	if _, err := DefaultHeartbeatConfig("../bad", "1", "2", "https://example.com", "/bin/tool", 30*time.Second); err == nil {
+		t.Fatal("unsafe name accepted")
+	}
+	if _, err := DefaultHeartbeatConfig("safe", "1", "2", "https://example.com", "/bin/tool", 5*time.Second); err == nil {
+		t.Fatal("fast interval accepted")
+	}
+}
+
+func TestAutomationScriptsUseExactIDsWithoutActivation(t *testing.T) {
+	source := executeJXA()
+	for _, want := range []string{"windows.whose", "tabs.whose", "c.execute"} {
+		if !strings.Contains(source, want) {
+			t.Fatalf("execute script missing %q", want)
+		}
