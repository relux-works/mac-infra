+}
+
+func TestRedactTabURLRemovesFragmentAndSensitiveQueryValues(t *testing.T) {
+	got := redactTabURL("https://example.com/path?code=secret&next=ok#conversation/private")
+	if strings.Contains(got, "secret") || strings.Contains(got, "private") {
+		t.Fatalf("redacted URL leaked sensitive values: %q", got)
+	}
+	for _, want := range []string{"code=%5Bredacted%5D", "next=ok", "#%5Bredacted%5D"} {
+		if !strings.Contains(got, want) {
+			t.Fatalf("redacted URL missing %q: %q", want, got)
