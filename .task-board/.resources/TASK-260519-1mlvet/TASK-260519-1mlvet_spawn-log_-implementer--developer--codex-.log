+func entryChildExists(parent diskprofile.Entry, name string) bool {
+	for _, child := range parent.Children {
+		if child.Name == name {
+			return true
+		}
+	}
+	return false
+}
+
+func containsString(values []string, want string) bool {
+	for _, value := range values {
