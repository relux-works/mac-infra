func retainTopEntry(entries []Entry, entry Entry, limit int) []Entry {
	if limit <= 0 {
		limit = DefaultLimit
	}
	entries = append(entries, entry)
	if len(entries) <= limit*2 {
		return entries
	}
	return limitEntries(entries, limit)
}

