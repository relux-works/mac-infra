+func argsAfterAuthorizedTarget(args []string) []string {
+	var out []string
+	for i := 0; i < len(args); i++ {
+		switch args[i] {
+		case "--window-id", "--tab-id", "--origin":
+			i++
+		case "--human-authorized":
+		default:
+			out = append(out, args[i])
+		}
+	}
+	return out
+}
