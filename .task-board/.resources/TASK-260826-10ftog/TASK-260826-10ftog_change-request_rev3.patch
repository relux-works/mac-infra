+			entries, err := os.ReadDir(filepath.Dir(outPath))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(entries) != 1 || entries[0].Name() != filepath.Base(outPath) {
+				t.Fatalf("temporary output was not cleaned up: %v", entries)
+			}
+		})
+	}
+}
