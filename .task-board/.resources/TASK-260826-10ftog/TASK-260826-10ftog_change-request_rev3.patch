+		return runHeartbeat(args[1:], stdout, stderr)
+	case "version":
+		fmt.Fprintf(stdout, "mac-chrome-session %s %s %s\n", Version, Commit, BuildDate)
+		return 0
+	case "help", "-h", "--help":
+		usage(stdout)
+		return 0
