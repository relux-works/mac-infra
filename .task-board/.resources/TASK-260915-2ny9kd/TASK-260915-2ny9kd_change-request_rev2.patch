+	client, err = startFake(t, "exit-early")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.Call(context.Background(), signerclient.Request{Op: signerclient.OpPub}); !errors.Is(err, signerclient.ErrProtocol) {
+		t.Fatalf("exit-early: %v", err)
+	}
