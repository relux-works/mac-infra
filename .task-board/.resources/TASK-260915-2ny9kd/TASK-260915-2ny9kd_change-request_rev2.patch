+	defer cancel()
+	if _, err := client.Call(ctx, signerclient.Request{Op: signerclient.OpPub}); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("silent: %v, want DeadlineExceeded", err)
