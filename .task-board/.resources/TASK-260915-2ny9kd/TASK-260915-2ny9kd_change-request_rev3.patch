diff --git a/internal/keyvault/testdata/signer-v1/backend-failure-01-sign-failure.json b/internal/keyvault/testdata/signer-v1/backend-failure-01-sign-failure.json
new file mode 100644
index 0000000..66e01b7
--- /dev/null
+++ b/internal/keyvault/testdata/signer-v1/backend-failure-01-sign-failure.json
@@ -0,0 +1,10 @@
+{
+  "session": "backend-failure",
+  "note": "negative: a backend error that is not an OSStatus is failure (no os_status)",
