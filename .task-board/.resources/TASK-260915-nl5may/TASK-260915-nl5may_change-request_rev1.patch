+	case format == keyvault.FormatSignatureDERLowS || format == keyvault.FormatSignatureRaw:
+		return format, nil
+	case format != "":
+		return "", usagef("--format must be %s or %s, got %q", keyvault.FormatSignatureDERLowS, keyvault.FormatSignatureRaw, format)
