	MaxRetainedTopEntries     = 1000
	DefaultMaxRetainedEntries = 10000
	MaxRetainedEntriesLimit   = 50000
)

var DefaultExcludes = []string{
	".git",
	".hg",
	".svn",
	".temp",
	".build",
	"build",
