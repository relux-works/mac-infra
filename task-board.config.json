{
  "mode": "local",
  "local": {
    "board_dir": ".task-board"
  },
  "version_control": {
    "confirm": true,
    "desired_commit_time": "backdated to previous day, after 20:00 MSK (evening) per owner policy"
  },
  "spawn": {
    "enabled": true,
    "max_parallel": 20,
    "worktree_isolation": {
      "validation": {
        "commands": [
          "go test -count=1 ./...",
          "go vet ./...",
          "go build ./..."
        ]
      }
    },
    "ceilings": {
      "contract_version": "spawn-policy-v4",
      "codex": {
        "entries": [
          {
            "criterion": "equal",
            "model": "gpt-5.6-sol",
            "reasoning_effort": "medium"
          }
        ],
        "adjustment_confirmation": "none",
        "roles": {
          "orchestrator": {
            "default_model": "gpt-5.6-sol",
            "default_reasoning_effort": "medium"
          }
        }
      },
      "claude": {
        "entries": [
          {
            "criterion": "equal",
            "model": "claude-opus-5",
            "reasoning_effort": "medium"
          }
        ],
        "adjustment_confirmation": "none",
        "roles": {
          "orchestrator": {
            "default_model": "claude-opus-5",
            "default_reasoning_effort": "medium"
          }
        }
      }
    },
    "preferred_agentic_system": {
      "mixed": [
        "claude",
        "codex"
      ]
    }
  }
}
